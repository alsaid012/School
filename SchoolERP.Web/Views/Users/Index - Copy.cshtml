@using SchoolERP.Domain.Enums
@model SchoolERP.Web.Models.UserSearchViewModel

@{
    ViewData["Title"] = "المستخدمين";
    ViewData["PageTitle"] = "إدارة المستخدمين";
}

<!-- ============================================================ -->
<!-- عنوان الصفحة + زر الإضافة -->
<!-- ============================================================ -->
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h4 class="mb-0"><i class="fas fa-users me-2"></i>@ViewData["PageTitle"]</h4>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-user-plus me-2"></i>إضافة مستخدم جديد
    </a>
</div>

<!-- ============================================================ -->
<!-- رسائل التنبيه -->
<!-- ============================================================ -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ============================================================ -->
<!-- شريط البحث والفلترة -->
<!-- ============================================================ -->
<div class="card mb-3 shadow-sm">
    <div class="card-body">
        <form method="get" asp-action="Index">
            <div class="row g-2 g-md-3">
                <div class="col-12 col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" name="searchTerm" class="form-control" placeholder="بحث بالاسم أو البريد..." value="@Model.SearchTerm" />
                    </div>
                </div>
         <!-- ====== فلترة حسب نوع المستخدم ====== -->
                <div class="col-6 col-md-2">
                    <select name="userType" class="form-select">
                        <option value="">الكل</option>
                        @if (Model.UserType == UserType.Student)
                        {
                            <option value="1" selected>طالب</option>
                        }
                        else
                        {
                            <option value="1">طالب</option>
                        }

                        @if (Model.UserType == UserType.Teacher)
                        {
                            <option value="2" selected>معلم</option>
                        }
                        else
                        {
                            <option value="2">معلم</option>
                        }

                        @if (Model.UserType == UserType.Employee)
                        {
                            <option value="3" selected>موظف</option>
                        }
                        else
                        {
                            <option value="3">موظف</option>
                        }

                        @if (Model.UserType == UserType.Principal)
                        {
                            <option value="4" selected>مدير</option>
                        }
                        else
                        {
                            <option value="4">مدير</option>
                        }

                        @if (Model.UserType == UserType.Admin)
                        {
                            <option value="5" selected>أدمن</option>
                        }
                        else
                        {
                            <option value="5">أدمن</option>
                        }
                    </select>
                </div>
            <!-- ====== فلترة حسب الحالة ====== -->
                <div class="col-6 col-md-2">
                    <select name="status" class="form-select">
                        <option value="">الكل</option>
                        @if (Model.Status == UserStatus.Pending)
                        {
                            <option value="0" selected>معلق</option>
                        }
                        else
                        {
                            <option value="0">معلق</option>
                        }

                        @if (Model.Status == UserStatus.Active)
                        {
                            <option value="1" selected>نشط</option>
                        }
                        else
                        {
                            <option value="1">نشط</option>
                        }

                        @if (Model.Status == UserStatus.Suspended)
                        {
                            <option value="2" selected>موقوف</option>
                        }
                        else
                        {
                            <option value="2">موقوف</option>
                        }

                        @if (Model.Status == UserStatus.Inactive)
                        {
                            <option value="3" selected>غير نشط</option>
                        }
                        else
                        {
                            <option value="3">غير نشط</option>
                        }
                    </select>
                </div>
            <!-- ====== فلترة حسب المدرسة ====== -->
                <div class="col-6 col-md-2">
                    <select name="schoolId" class="form-select">
                        <option value="">كل المدارس</option>
                        @if (Model.Schools != null)
                        {
                            foreach (var school in Model.Schools)
                            {
                                if (Model.SchoolId == school.Id)
                                {
                                    <option value="@school.Id" selected>@school.SchoolName</option>
                                }
                                else
                                {
                                    <option value="@school.Id">@school.SchoolName</option>
                                }

                            }
                        }
                    </select>
                </div>
                <!-- زر البحث -->
                <div class="col-6 col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search me-1"></i>بحث
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

