<!-- ============================================================ -->
<!-- جدول المستخدمين -->
<!-- ============================================================ -->
<div class="table-responsive">
    <table class="table table-striped table-hover table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th style="width: 50px;">#</th>
                <th style="min-width: 120px;">الصورة</th>
                <th style="min-width: 120px;">اسم المستخدم</th>
                <th style="min-width: 140px;">الاسم الكامل</th>
                <th style="min-width: 180px;">البريد الإلكتروني</th>
                <th style="min-width: 100px;">نوع المستخدم</th>
                <th style="min-width: 120px;">المدرسة</th>
                <th style="min-width: 100px;">الحالة</th>
                <th style="min-width: 200px;">الإجراءات</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Users != null && Model.Users.Any())
            {
                int index = 1;
                foreach (var user in Model.Users)
                {
                    <tr>
                        <td class="text-center">@index</td>
                        <td class="text-center">
                            @if (!string.IsNullOrEmpty(user.ProfilePicture))
                            {
                                <img src="@user.ProfilePicture" alt="@user.FullName" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-secondary d-inline-flex align-items-center justify-content-center text-white" style="width: 40px; height: 40px; font-size: 16px;">
                                    @user.FullName?.FirstOrDefault()
                                </div>
                            }
                        </td>
                        <td><strong>@user.Username</strong></td>
                        <td>@user.FullName</td>
                        <td dir="ltr">@user.Email</td>
                        <td>
                            <span class="badge bg-info text-white">
                                @user.UserType
                            </span>
                        </td>
                        <td>@user.SchoolName</td>
                    
                        <td>
                            @if (user.Status == UserStatus.Active)
                            {
                                <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>نشط</span>
                            }
                            else if (user.Status == UserStatus.Pending)
                            {
                                <span class="badge bg-warning"><i class="fas fa-clock me-1"></i>معلق</span>
                            }
                            else if (user.Status == UserStatus.Suspended)
                            {
                                <span class="badge bg-danger"><i class="fas fa-ban me-1"></i>موقوف</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary"><i class="fas fa-circle me-1"></i>غير نشط</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm flex-wrap gap-1" role="group">
                                <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-info btn-sm" title="تفاصيل">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-warning btn-sm" title="تعديل">
                                    <i class="fas fa-edit"></i>
                                </a>
                                @if (user.Status != UserStatus.Active)
                                {
                                    <form asp-action="Activate" asp-route-id="@user.Id" method="post" style="display:inline;">
                                        <button type="submit" class="btn btn-success btn-sm" title="تفعيل" onclick="return confirm('هل أنت متأكد من تفعيل هذا المستخدم؟')">
                                            <i class="fas fa-check"></i>
                                        </button>
                                    </form>
                                }
                                @if (user.Status != UserStatus.Suspended)
                                {
                                    <form asp-action="Suspend" asp-route-id="@user.Id" method="post" style="display:inline;">
                                        <button type="submit" class="btn btn-danger btn-sm" title="تعليق" onclick="return confirm('هل أنت متأكد من تعليق هذا المستخدم؟')">
                                            <i class="fas fa-ban"></i>
                                        </button>
                                    </form>
                                }
                                <form asp-action="Delete" asp-route-id="@user.Id" method="post" style="display:inline;">
                                    <button type="submit" class="btn btn-danger btn-sm" title="حذف" onclick="return confirm('هل أنت متأكد من حذف هذا المستخدم؟')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    index++;
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">
                        <i class="fas fa-users fa-2x d-block mb-2"></i>
                        لا يوجد مستخدمين
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- ============================================================ -->
<!-- إحصائيات سريعة -->
<!-- ============================================================ -->
<div class="row g-3 mt-2">
    <div class="col-6 col-md-3">
        <div class="card bg-light shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-muted mb-1"><i class="fas fa-users me-1"></i>الإجمالي</h6>
                <h3 class="mb-0">@Model.TotalCount</h3>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-success shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-success mb-1"><i class="fas fa-check-circle me-1"></i>نشط</h6>
                <h3 class="mb-0 text-success">@Model.ActiveCount</h3>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-warning shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-warning mb-1"><i class="fas fa-clock me-1"></i>معلق</h6>
                <h3 class="mb-0 text-warning">@Model.PendingCount</h3>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-danger shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-danger mb-1"><i class="fas fa-ban me-1"></i>موقوف</h6>
                <h3 class="mb-0 text-danger">@Model.SuspendedCount</h3>
            </div>
        </div>
    </div>
</div>