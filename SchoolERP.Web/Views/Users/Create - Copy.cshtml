@model SchoolERP.Web.Models.CreateUserViewModel

@{
    ViewData["Title"] = "إنشاء مستخدم جديد";
    ViewData["PageTitle"] = "إنشاء مستخدم جديد";
}

<div class="card shadow-sm">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0"><i class="fas fa-user-plus me-2"></i>إنشاء مستخدم جديد</h5>
    </div>
    <div class="card-body">
        <form method="post" asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- ============================================================ -->
            <!-- الصف الأول: اسم المستخدم + الاسم الكامل -->
            <!-- ============================================================ -->
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="User.Username" class="form-label">
                            <i class="fas fa-user me-1"></i>اسم المستخدم <span class="text-danger">*</span>
                        </label>
                        <input asp-for="User.Username" class="form-control" placeholder="أدخل اسم المستخدم" />
                        <span asp-validation-for="User.Username" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="User.FullName" class="form-label">
                            <i class="fas fa-user-circle me-1"></i>الاسم الكامل <span class="text-danger">*</span>
                        </label>
                        <input asp-for="User.FullName" class="form-control" placeholder="أدخل الاسم الكامل" />
                        <span asp-validation-for="User.FullName" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- ============================================================ -->
            <!-- الصف الثاني: كلمة المرور + تأكيد كلمة المرور -->
            <!-- ============================================================ -->
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="User.Password" class="form-label">
                            <i class="fas fa-lock me-1"></i>كلمة المرور <span class="text-danger">*</span>
                        </label>
                        <input asp-for="User.Password" type="password" class="form-control" placeholder="أدخل كلمة المرور" />
                        <span asp-validation-for="User.Password" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="User.ConfirmPassword" class="form-label">
                            <i class="fas fa-check-circle me-1"></i>تأكيد كلمة المرور <span class="text-danger">*</span>
                        </label>
                        <input asp-for="User.ConfirmPassword" type="password" class="form-control" placeholder="أعد إدخال كلمة المرور" />
                        <span asp-validation-for="User.ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- ============================================================ -->
            <!-- الصف الثالث: الرقم القومي + تاريخ الميلاد -->
            <!-- ============================================================ -->
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="User.NationalId" class="form-label">
                            <i class="fas fa-id-card me-1"></i>الرقم القومي <span class="text-danger">*</span>
                        </label>
                        <input asp-for="User.NationalId" class="form-control" placeholder="14 رقم" />
                        <span asp-validation-for="User.NationalId" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="User.DateOfBirth" class="form-label">
                            <i class="fas fa-calendar me-1"></i>تاريخ الميلاد <span class="text-danger">*</span>
                        </label>
                        <input asp-for="User.DateOfBirth" type="date" class="form-control" />
                        <span asp-validation-for="User.DateOfBirth" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- ============================================================ -->
            <!-- الصف الرابع: البريد الإلكتروني + رقم الهاتف -->
            <!-- ============================================================ -->
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="User.Email" class="form-label">
                            <i class="fas fa-envelope me-1"></i>البريد الإلكتروني
                        </label>
                        <input asp-for="User.Email" type="email" class="form-control" placeholder="example@email.com" />
                        <span asp-validation-for="User.Email" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="User.PhoneNumber" class="form-label">
                            <i class="fas fa-phone me-1"></i>رقم الهاتف
                        </label>
                        <input asp-for="User.PhoneNumber" class="form-control" placeholder="01xxxxxxxxx" />
                        <span asp-validation-for="User.PhoneNumber" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- ============================================================ -->
            <!-- الصف الخامس: نوع المستخدم + المدرسة -->
            <!-- ============================================================ -->
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="User.UserType" class="form-label">
                            <i class="fas fa-user-tag me-1"></i>نوع المستخدم <span class="text-danger">*</span>
                        </label>
                        <select asp-for="User.UserType" class="form-select">
                            <option value="">اختر النوع...</option>
                            <option value="1">طالب</option>
                            <option value="2">معلم</option>
                            <option value="3">موظف</option>
                            <option value="4">مدير</option>
                            <option value="5">أدمن</option>
                        </select>
                        <span asp-validation-for="User.UserType" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="User.SchoolId" class="form-label">
                            <i class="fas fa-school me-1"></i>المدرسة <span class="text-danger">*</span>
                        </label>
                        <select asp-for="User.SchoolId" class="form-select">
                            <option value="">اختر المدرسة...</option>
                            @if (Model.Schools != null)
                            {
                                foreach (var school in Model.Schools)
                                {
                                    <option value="@school.Id">@school.SchoolName</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="User.SchoolId" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- ============================================================ -->
            <!-- الصف السادس: النوع الاجتماعي + العنوان -->
            <!-- ============================================================ -->
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="User.Gender" class="form-label">
                            <i class="fas fa-venus-mars me-1"></i>النوع الاجتماعي
                        </label>
                        <select asp-for="User.Gender" class="form-select">
                            <option value="">اختر النوع...</option>
                            <option value="ذكر">ذكر</option>
                            <option value="أنثى">أنثى</option>
                        </select>
                        <span asp-validation-for="User.Gender" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="User.Address" class="form-label">
                            <i class="fas fa-home me-1"></i>العنوان
                        </label>
                        <input asp-for="User.Address" class="form-control" placeholder="أدخل العنوان" />
                        <span asp-validation-for="User.Address" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- ============================================================ -->
            <!-- الصورة الشخصية -->
            <!-- ============================================================ -->
            <div class="mb-3">
                <label asp-for="User.ProfileImage" class="form-label">
                    <i class="fas fa-image me-1"></i>الصورة الشخصية
                </label>
                <input asp-for="User.ProfileImage" type="file" class="form-control" accept="image/*" onchange="previewImage(event)" />
                <span asp-validation-for="User.ProfileImage" class="text-danger"></span>
                <div id="imagePreview" class="mt-2" style="display: none;">
                    <img id="preview" src="#" alt="معاينة الصورة" class="rounded-circle" style="width: 150px; height: 150px; object-fit: cover; border: 2px solid #ddd;" />
                </div>
            </div>

            <!-- ============================================================ -->
            <!-- جهات الاتصال (Contact) -->
            <!-- ============================================================ -->
            <div class="mb-3">
                <label class="form-label"><i class="fas fa-address-book me-1"></i>جهات الاتصال</label>
                <div id="contactsContainer">
                    <div class="row contact-row">
                        <div class="col-md-4">
                            <select name="User.Contacts[0].ContactType" class="form-select">
                                <option value="1">هاتف</option>
                                <option value="2">موبايل</option>
                                <option value="3">بريد إلكتروني</option>
                                <option value="4">واتساب</option>
                            </select>
                        </div>
                        <div class="col-md-5">
                            <input type="text" name="User.Contacts[0].ContactValue" class="form-control" placeholder="القيمة" />
                        </div>
                        <div class="col-md-2">
                            <div class="form-check mt-2">
                                <input type="checkbox" name="User.Contacts[0].IsPrimary" class="form-check-input" value="true" />
                                <label class="form-check-label">أساسي</label>
                            </div>
                        </div>
                        <div class="col-md-1">
                            <button type="button" class="btn btn-danger btn-sm remove-contact" onclick="removeContact(this)">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <button type="button" class="btn btn-outline-primary btn-sm mt-2" onclick="addContact()">
                    <i class="fas fa-plus me-1"></i>إضافة جهة اتصال
                </button>
            </div>

            <!-- ============================================================ -->
            <!-- أزرار الحفظ والإلغاء -->
            <!-- ============================================================ -->
            <hr />
            <button type="submit" class="btn btn-success">
                <i class="fas fa-save me-2"></i>حفظ
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-times me-2"></i>إلغاء
            </a>
        </form>
    </div>
</div>

<!-- ============================================================ -->
<!-- Scripts -->
<!-- ============================================================ -->
@section Scripts {
    <script>
        // معاينة الصورة
        function previewImage(event) {
            const input = event.target;
            const previewContainer = document.getElementById('imagePreview');
            const preview = document.getElementById('preview');

            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.src = e.target.result;
                    previewContainer.style.display = 'block';
                }
                reader.readAsDataURL(input.files[0]);
            } else {
                previewContainer.style.display = 'none';
            }
        }

        // إضافة جهة اتصال جديدة
        let contactIndex = 1;

        function addContact() {
            const container = document.getElementById('contactsContainer');
            const newRow = document.createElement('div');
            newRow.className = 'row contact-row mt-2';
            newRow.innerHTML = `
                <div class="col-md-4">
                    <select name="User.Contacts[${contactIndex}].ContactType" class="form-select">
                        <option value="1">هاتف</option>
                        <option value="2">موبايل</option>
                        <option value="3">بريد إلكتروني</option>
                        <option value="4">واتساب</option>
                    </select>
                </div>
                <div class="col-md-5">
                    <input type="text" name="User.Contacts[${contactIndex}].ContactValue" class="form-control" placeholder="القيمة" />
                </div>
                <div class="col-md-2">
                    <div class="form-check mt-2">
                        <input type="checkbox" name="User.Contacts[${contactIndex}].IsPrimary" class="form-check-input" value="true" />
                        <label class="form-check-label">أساسي</label>
                    </div>
                </div>
                <div class="col-md-1">
                    <button type="button" class="btn btn-danger btn-sm remove-contact" onclick="removeContact(this)">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            `;
            container.appendChild(newRow);
            contactIndex++;
        }

        // حذف جهة اتصال
        function removeContact(button) {
            const row = button.closest('.contact-row');
            if (document.querySelectorAll('.contact-row').length > 1) {
                row.remove();
            } else {
                alert('يجب أن يكون هناك على الأقل جهة اتصال واحدة');
            }
        }
    </script>
}