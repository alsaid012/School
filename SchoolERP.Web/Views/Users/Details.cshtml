@model SchoolERP.Application.DTOs.Users.UserDetailsDto

@{
    ViewData["Title"] = "تفاصيل المستخدم";
    ViewData["PageTitle"] = "تفاصيل المستخدم";
}

<div class="card shadow-sm">
    <div class="card-header bg-info text-white">
        <h5 class="mb-0"><i class="fas fa-user me-2"></i>@Model.FullName</h5>
    </div>
    <div class="card-body">
        <!-- ============================================================ -->
        <!-- الصورة الشخصية -->
        <!-- ============================================================ -->
        <div class="text-center mb-3">
            @if (!string.IsNullOrEmpty(Model.ProfilePicture))
            {
                <img src="@Model.ProfilePicture" alt="@Model.FullName" class="rounded-circle" style="width: 150px; height: 150px; object-fit: cover; border: 3px solid #0d6efd;" />
            }
            else
            {
                <div class="rounded-circle bg-secondary d-inline-flex align-items-center justify-content-center text-white" style="width: 150px; height: 150px; font-size: 64px;">
                    @Model.FullName?.FirstOrDefault()
                </div>
            }
        </div>

        <dl class="row">
            <dt class="col-sm-3">اسم المستخدم</dt>
            <dd class="col-sm-9">@Model.Username</dd>

            <dt class="col-sm-3">الاسم الكامل</dt>
            <dd class="col-sm-9">@Model.FullName</dd>

            <dt class="col-sm-3">الرقم القومي</dt>
            <dd class="col-sm-9">@Model.NationalId</dd>

            <dt class="col-sm-3">البريد الإلكتروني</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">رقم الهاتف</dt>
            <dd class="col-sm-9">@Model.PhoneNumber</dd>

            <dt class="col-sm-3">النوع الاجتماعي</dt>
            <dd class="col-sm-9">@Model.Gender</dd>

            <dt class="col-sm-3">تاريخ الميلاد</dt>
            <dd class="col-sm-9">@Model.DateOfBirth.ToString("yyyy-MM-dd")</dd>

            <dt class="col-sm-3">العنوان</dt>
            <dd class="col-sm-9">@Model.Address</dd>

            <dt class="col-sm-3">نوع المستخدم</dt>
            <dd class="col-sm-9">
                <span class="badge bg-info">@Model.UserType</span>
            </dd>

            <dt class="col-sm-3">الحالة</dt>
            <dd class="col-sm-9">
                @if (Model.Status == SchoolERP.Domain.Enums.UserStatus.Active)
                {
                    <span class="badge bg-success">نشط</span>
                }
                else if (Model.Status == SchoolERP.Domain.Enums.UserStatus.Pending)
                {
                    <span class="badge bg-warning">معلق</span>
                }
                else if (Model.Status == SchoolERP.Domain.Enums.UserStatus.Suspended)
                {
                    <span class="badge bg-danger">موقوف</span>
                }
                else
                {
                    <span class="badge bg-secondary">غير نشط</span>
                }
            </dd>

            <dt class="col-sm-3">المدرسة</dt>
            <dd class="col-sm-9">@Model.SchoolName</dd>

            <dt class="col-sm-3">تاريخ آخر تسجيل دخول</dt>
            <dd class="col-sm-9">@(Model.LastLogin?.ToString("yyyy-MM-dd HH:mm") ?? "لم يسجل بعد")</dd>

            <dt class="col-sm-3">تاريخ الإنشاء</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>

            <dt class="col-sm-3">آخر تحديث</dt>
            <dd class="col-sm-9">@(Model.UpdatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</dd>
        </dl>

        @if (Model.UserRoles != null && Model.UserRoles.Any())
        {
            <hr />
            <h6><i class="fas fa-tags me-2"></i>الأدوار</h6>
            <div>
                @foreach (var role in Model.UserRoles)
                {
                    <span class="badge bg-primary me-1">@role.RoleType @(role.IsPrimary ? "(أساسي)" : "")</span>
                }
            </div>
        }

        @if (Model.Contacts != null && Model.Contacts.Any())
        {
            <hr />
            <h6><i class="fas fa-address-book me-2"></i>جهات الاتصال</h6>
            <table class="table table-sm table-bordered">
                <thead>
                    <tr>
                        <th>النوع</th>
                        <th>القيمة</th>
                        <th>أساسي</th>
                        <th>موثق</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var contact in Model.Contacts)
                    {
                        <tr>
                            <td>@contact.ContactType</td>
                            <td>@contact.ContactValue</td>
                            <td>@(contact.IsPrimary ? "نعم" : "لا")</td>
                            <td>@(contact.IsVerified ? "نعم" : "لا")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
    <div class="card-footer">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-right me-2"></i>العودة
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
            <i class="fas fa-edit me-2"></i>تعديل
        </a>
    </div>
</div>