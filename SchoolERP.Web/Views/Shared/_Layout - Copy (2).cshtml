<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - نظام إدارة المدارس</title>

    <!-- ============================================================ -->
    <!-- 📦  المكتبات الخارجية (CDN) -->
    <!-- ============================================================ -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700&display=swap" rel="stylesheet">

    <!-- ============================================================ -->
    <!-- 📦  المكتبات المحلية -->
    <!-- ============================================================ -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />

    <!-- ============================================================ -->
    <!-- 🎨  التنسيقات المخصصة -->
    <!-- ============================================================ -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @* ✅ تنسيقات خاصة بالصفحة *@
    @await RenderSectionAsync("Styles", required: false)

    <style>
        /* تنسيقات مؤقتة لحين تحميل الملفات */
        body {
            font-family: 'Cairo', sans-serif;
            background-color: #f8f9fa;
        }
    </style>
</head>
<body>

    <!-- ============================================================ -->
    <!-- 🏗️  Navbar العلوي -->
    <!-- ============================================================ -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
        <div class="container-fluid px-4">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                <i class="fas fa-school me-2"></i>نظام إدارة المدارس
            </a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="d-flex align-items-center gap-3 text-white">
                    <span>
                        <i class="fas fa-user-circle me-1"></i>
                        @{
                            var fullName = User.FindFirst("FullName")?.Value ?? "مستخدم";
                        }
                        @fullName
                    </span>
                    <a asp-controller="Auth" asp-action="Logout" class="btn btn-outline-light btn-sm">
                        <i class="fas fa-sign-out-alt"></i> خروج
                    </a>
                </div>
            }
            else
            {
                <div>
                    <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-light btn-sm">
                        <i class="fas fa-sign-in-alt"></i> دخول
                    </a>
                    <a asp-controller="Auth" asp-action="Register" class="btn btn-light btn-sm ms-2">
                        <i class="fas fa-user-plus"></i> حساب جديد
                    </a>
                </div>
            }
        </div>
    </nav>

    <!-- ============================================================ -->
    <!-- 📱  الـ Sidebar والمحتوى الرئيسي -->
    <!-- ============================================================ -->
    <div class="container-fluid">
        <div class="row">

            @if (User.Identity?.IsAuthenticated == true)
            {
                <!-- Sidebar -->
                <nav class="col-md-2 col-lg-2 d-md-block bg-light sidebar vh-100 p-0">
                    <div class="position-sticky pt-3">
                        <ul class="nav flex-column">

                            <!-- ====== القسم الرئيسي ====== -->
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")"
                                   asp-controller="Home" asp-action="Index">
                                    <i class="fas fa-chart-pie"></i> لوحة التحكم
                                </a>
                            </li>

                            <!-- ====== إدارة المستخدمين ====== -->
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Users" ? "active" : "")"
                                   asp-controller="Users" asp-action="Index">
                                    <i class="fas fa-users"></i> المستخدمين
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Students" ? "active" : "")"
                                   asp-controller="Students" asp-action="Index">
                                    <i class="fas fa-user-graduate"></i> الطلاب
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Teachers" ? "active" : "")"
                                   asp-controller="Teachers" asp-action="Index">
                                    <i class="fas fa-chalkboard-teacher"></i> المعلمين
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Employees" ? "active" : "")"
                                   asp-controller="Employees" asp-action="Index">
                                    <i class="fas fa-user-tie"></i> الموظفين
                                </a>
                            </li>

                            <!-- ====== إدارة المدارس ====== -->
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Schools" ? "active" : "")"
                                   asp-controller="Schools" asp-action="Index">
                                    <i class="fas fa-building"></i> المدارس
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Governorates" ? "active" : "")"
                                   asp-controller="Governorates" asp-action="Index">
                                    <i class="fas fa-map-marker-alt"></i> المحافظات
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Departments" ? "active" : "")"
                                   asp-controller="Departments" asp-action="Index">
                                    <i class="fas fa-sitemap"></i> الإدارات
                                </a>
                            </li>

                            <!-- ====== الصفوف والفصول ====== -->
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "GradeLevels" ? "active" : "")"
                                   asp-controller="GradeLevels" asp-action="Index">
                                    <i class="fas fa-graduation-cap"></i> الصفوف الدراسية
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "ClassRooms" ? "active" : "")"
                                   asp-controller="ClassRooms" asp-action="Index">
                                    <i class="fas fa-door-open"></i> الفصول الدراسية
                                </a>
                            </li>

                            <!-- ====== المواد الدراسية ====== -->
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Subjects" ? "active" : "")"
                                   asp-controller="Subjects" asp-action="Index">
                                    <i class="fas fa-book"></i> المواد الدراسية
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "TeacherSubjects" ? "active" : "")"
                                   asp-controller="TeacherSubjects" asp-action="Index">
                                    <i class="fas fa-link"></i> ربط المعلم بالمادة
                                </a>
                            </li>

                            <!-- ====== الجدول الدراسي ====== -->
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "ClassSchedules" ? "active" : "")"
                                   asp-controller="ClassSchedules" asp-action="Index">
                                    <i class="fas fa-calendar-alt"></i> جدول الحصص
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AcademicYears" ? "active" : "")"
                                   asp-controller="AcademicYears" asp-action="Index">
                                    <i class="fas fa-calendar"></i> العام الدراسي
                                </a>
                            </li>

                            <!-- ====== الامتحانات ====== -->
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Exams" ? "active" : "")"
                                   asp-controller="Exams" asp-action="Index">
                                    <i class="fas fa-pencil-alt"></i> الامتحانات
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "ExamResults" ? "active" : "")"
                                   asp-controller="ExamResults" asp-action="Index">
                                    <i class="fas fa-chart-bar"></i> نتائج الامتحانات
                                </a>
                            </li>

                            <!-- ====== الحضور ====== -->
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "StudentAttendances" ? "active" : "")"
                                   asp-controller="StudentAttendances" asp-action="Index">
                                    <i class="fas fa-check-circle"></i> حضور الطلاب
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "EmployeeAttendances" ? "active" : "")"
                                   asp-controller="EmployeeAttendances" asp-action="Index">
                                    <i class="fas fa-clock"></i> حضور الموظفين
                                </a>
                            </li>

                            <!-- ====== جهات الاتصال والأدوار ====== -->
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "UserContacts" ? "active" : "")"
                                   asp-controller="UserContacts" asp-action="Index">
                                    <i class="fas fa-address-book"></i> جهات الاتصال
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "UserRoles" ? "active" : "")"
                                   asp-controller="UserRoles" asp-action="Index">
                                    <i class="fas fa-user-tag"></i> أدوار المستخدمين
                                </a>
                            </li>

                            <!-- ====== التقارير ====== -->
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Reports" ? "active" : "")"
                                   asp-controller="Reports" asp-action="Index">
                                    <i class="fas fa-file-alt"></i> التقارير
                                </a>
                            </li>

                            
                            <li class="nav-item">
                                <hr class="dropdown-divider" style="border-color: rgba(0,0,0,0.1); margin: 8px 16px;" />
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-danger" asp-controller="Auth" asp-action="Logout">
                                    <i class="fas fa-sign-out-alt"></i> تسجيل الخروج
                                </a>
                            </li>
                        </ul>
                    </div>
                </nav>

                <!-- Main Content -->
                <main class="col-md-10 col-lg-10 ms-sm-auto px-md-4 py-3">
                    @RenderBody()
                </main>
            }
            else
            {
                <!-- Full width (Login/Register pages) -->
                <main class="col-12 p-0">
                    @RenderBody()
                </main>
            }

        </div>
    </div>

    <!-- ============================================================ -->
    <!-- ✅ Footer -->
    <!-- ============================================================ -->
    <footer class="footer mt-auto py-3 bg-white border-top">
        <div class="container-fluid px-4">
            <div class="row">
                <div class="col-12 text-center">
                    <span class="text-muted">
                        &copy; 2026 <strong>SchoolERP</strong> - نظام إدارة المدارس
                        <span class="mx-2">|</span>
                        الإصدار 1.0
                        <span class="mx-2">|</span>
                        <i class="fas fa-clock me-1"></i>
                        <span class="current-time">00:00:00</span>
                        <span class="current-date me-3">00/00/0000</span>
                    </span>
                </div>
            </div>
        </div>
    </footer>

    <!-- ============================================================ -->
    <!-- 📦  السكريبتات الخارجية -->
    <!-- ============================================================ -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- ============================================================ -->
    <!-- 📦  السكريبتات المحلية -->
    <!-- ============================================================ -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap5.min.js"></script>

    <!-- ============================================================ -->
    <!-- 🛠️  السكريبتات المخصصة -->
    <!-- ============================================================ -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    @* ✅ سكريبتات خاصة بالصفحة *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

