<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - نظام إدارة المدارس</title>

    <!-- ============================================================ -->
    <!-- 📦  المكتبات الخارجية -->
    <!-- ============================================================ -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;800&display=swap" rel="stylesheet">

    <!-- ============================================================ -->
    <!-- 📦  المكتبات المحلية -->
    <!-- ============================================================ -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />

    <!-- ============================================================ -->
    <!-- 🎨  التنسيقات المخصصة (كل ملف في مكانه) -->
    <!-- ============================================================ -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true" />

    @* ✅ تنسيقات خاصة بالصفحة *@
    @await RenderSectionAsync("Styles", required: false)

</head>
<body>

    <!-- ============================================================ -->
    <!-- 🏗️  الشريط العلوي (Top Navbar)                               -->
    <!-- ============================================================ -->
    <nav class="top-navbar navbar navbar-expand-lg">
        <div class="container-fluid px-0">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <i class="fas fa-school"></i>
                نظام إدارة المدارس
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#topNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="topNavbar">
                <!-- بحث -->
                <div class="mx-auto position-relative">
                    <input type="text" class="search-box" placeholder="بحث..." />
                    <i class="fas fa-search position-absolute" style="left:15px; top:50%; transform:translateY(-50%); color:rgba(255,255,255,0.4);"></i>
                </div>

                <!-- القائمة اليمنى -->
                <ul class="navbar-nav ms-auto align-items-center gap-2">
                    <li class="nav-item position-relative">
                        <a class="nav-link" href="#" title="الإشعارات">
                            <i class="fas fa-bell fs-5"></i>
                            <span class="badge-notification">3</span>
                        </a>
                    </li>

                    <li class="nav-item dropdown user-dropdown">
                        <a class="dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown">
                            <span class="user-avatar">
                                @{
                                    var fullName = User.FindFirst("FullName")?.Value ?? "مستخدم";
                                    var initial = string.IsNullOrEmpty(fullName) ? "U" : fullName.Substring(0, 1);
                                }
                                @initial
                            </span>
                            <span class="d-none d-md-inline">@fullName</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3 mt-2">
                            <li><a class="dropdown-item" href="#"><i class="fas fa-user me-2"></i> الملف الشخصي</a></li>
                            <li><a class="dropdown-item" href="#"><i class="fas fa-cog me-2"></i> الإعدادات</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Auth" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="fas fa-sign-out-alt me-2"></i> تسجيل الخروج
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- ============================================================ -->
    <!-- 📱  الـ Sidebar والمحتوى الرئيسي                             -->
    <!-- ============================================================ -->
    <div class="container-fluid px-0">
        <div class="row g-0">

            @if (User.Identity?.IsAuthenticated == true)
            {
                <!-- Sidebar -->
                <div class="col-md-2 col-lg-2 sidebar-wrapper">
                    <div class="position-sticky">

                        @{
                            // =========================================================
                            // 🛡️  صلاحيات المستخدم
                            // =========================================================
                            var isAdmin = User.IsInRole("Admin");
                            var isPrincipal = User.IsInRole("Principal") || isAdmin;
                            var isTeacher = User.IsInRole("Teacher") || isPrincipal;
                            var isEmployee = User.IsInRole("Employee") || isPrincipal;
                            var isStudent = User.IsInRole("Student");

                            var canManageUsers = isAdmin;
                            var canManageSchools = isAdmin || isPrincipal;
                            var canManageAcademic = isAdmin || isPrincipal;
                            var canManageExams = isAdmin || isPrincipal || isTeacher;
                            var canManageAttendance = isAdmin || isPrincipal || isTeacher || isEmployee;
                            var canViewReports = isAdmin || isPrincipal || isTeacher || isEmployee;

                            var currentController = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
                            var isHome = currentController == "Home";
                            var isUsers = currentController == "Users" || currentController == "Students" || currentController == "Teachers" || currentController == "Employees";
                            var isSchools = currentController == "Schools" || currentController == "Governorates" || currentController == "Departments";
                            var isAcademic = currentController == "GradeLevels" || currentController == "ClassRooms" || currentController == "Subjects" || currentController == "TeacherSubjects";
                            var isSchedule = currentController == "ClassSchedules" || currentController == "AcademicYears";
                            var isExams = currentController == "Exams" || currentController == "ExamResults";
                            var isAttendance = currentController == "StudentAttendances" || currentController == "EmployeeAttendances";
                            var isContacts = currentController == "UserContacts" || currentController == "UserRoles";
                            var isReports = currentController == "Reports";
                        }

                        <!-- القسم 1: الرئيسية -->
                        <div class="sidebar-section">
                            <ul class="nav flex-column">
                                <li class="nav-item">
                                    <a class="nav-link @(isHome ? "active" : "")"
                                       asp-controller="Home" asp-action="Index">
                                        <i class="fas fa-chart-pie"></i> لوحة التحكم
                                    </a>
                                </li>
                            </ul>
                        </div>

                        <!-- القسم 2: إدارة المستخدمين (Admin فقط) -->
                        @if (canManageUsers)
                        {
                            <div class="sidebar-section">
                                <button class="section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#collapseUsers" aria-expanded="@(isUsers ? "true" : "false")">
                                    <span class="section-title-text">
                                        <i class="fas fa-users-cog"></i> إدارة المستخدمين
                                    </span>
                                    <span class="toggle-icon"><i class="fas fa-chevron-down"></i></span>
                                </button>
                                <div class="collapse @(isUsers ? "show" : "")" id="collapseUsers">
                                    <div class="collapse-content">
                                        <a class="nav-link @(currentController == "Users" ? "active" : "")"
                                           asp-controller="Users" asp-action="Index">
                                            <i class="fas fa-users"></i> المستخدمين
                                        </a>
                                        <a class="nav-link @(currentController == "Students" ? "active" : "")"
                                           asp-controller="Students" asp-action="Index">
                                            <i class="fas fa-user-graduate"></i> الطلاب
                                        </a>
                                        <a class="nav-link @(currentController == "Teachers" ? "active" : "")"
                                           asp-controller="Teachers" asp-action="Index">
                                            <i class="fas fa-chalkboard-teacher"></i> المعلمين
                                        </a>
                                        <a class="nav-link @(currentController == "Employees" ? "active" : "")"
                                           asp-controller="Employees" asp-action="Index">
                                            <i class="fas fa-user-tie"></i> الموظفين
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- القسم 3: إدارة المدارس (Admin, Principal) -->
                        @if (canManageSchools)
                        {
                            <div class="sidebar-section">
                                <button class="section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSchools" aria-expanded="@(isSchools ? "true" : "false")">
                                    <span class="section-title-text">
                                        <i class="fas fa-school"></i> إدارة المدارس
                                    </span>
                                    <span class="toggle-icon"><i class="fas fa-chevron-down"></i></span>
                                </button>
                                <div class="collapse @(isSchools ? "show" : "")" id="collapseSchools">
                                    <div class="collapse-content">
                                        <a class="nav-link @(currentController == "Schools" ? "active" : "")"
                                           asp-controller="Schools" asp-action="Index">
                                            <i class="fas fa-building"></i> المدارس
                                        </a>
                                        <a class="nav-link @(currentController == "Governorates" ? "active" : "")"
                                           asp-controller="Governorates" asp-action="Index">
                                            <i class="fas fa-map-marker-alt"></i> المحافظات
                                        </a>
                                        <a class="nav-link @(currentController == "Departments" ? "active" : "")"
                                           asp-controller="Departments" asp-action="Index">
                                            <i class="fas fa-sitemap"></i> الإدارات
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- القسم 4: الصفوف والمواد (Admin, Principal, Teacher) -->
                        @if (canManageAcademic)
                        {
                            <div class="sidebar-section">
                                <button class="section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAcademic" aria-expanded="@(isAcademic ? "true" : "false")">
                                    <span class="section-title-text">
                                        <i class="fas fa-graduation-cap"></i> الصفوف والمواد
                                    </span>
                                    <span class="toggle-icon"><i class="fas fa-chevron-down"></i></span>
                                </button>
                                <div class="collapse @(isAcademic ? "show" : "")" id="collapseAcademic">
                                    <div class="collapse-content">
                                        <a class="nav-link @(currentController == "GradeLevels" ? "active" : "")"
                                           asp-controller="GradeLevels" asp-action="Index">
                                            <i class="fas fa-graduation-cap"></i> الصفوف الدراسية
                                        </a>
                                        <a class="nav-link @(currentController == "ClassRooms" ? "active" : "")"
                                           asp-controller="ClassRooms" asp-action="Index">
                                            <i class="fas fa-door-open"></i> الفصول الدراسية
                                        </a>
                                        <a class="nav-link @(currentController == "Subjects" ? "active" : "")"
                                           asp-controller="Subjects" asp-action="Index">
                                            <i class="fas fa-book"></i> المواد الدراسية
                                        </a>
                                        <a class="nav-link @(currentController == "TeacherSubjects" ? "active" : "")"
                                           asp-controller="TeacherSubjects" asp-action="Index">
                                            <i class="fas fa-link"></i> ربط المعلم بالمادة
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- القسم 5: الجدول الدراسي (Admin, Principal, Teacher) -->
                        @if (canManageAcademic)
                        {
                            <div class="sidebar-section">
                                <button class="section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSchedule" aria-expanded="@(isSchedule ? "true" : "false")">
                                    <span class="section-title-text">
                                        <i class="fas fa-calendar-alt"></i> الجدول الدراسي
                                    </span>
                                    <span class="toggle-icon"><i class="fas fa-chevron-down"></i></span>
                                </button>
                                <div class="collapse @(isSchedule ? "show" : "")" id="collapseSchedule">
                                    <div class="collapse-content">
                                        <a class="nav-link @(currentController == "ClassSchedules" ? "active" : "")"
                                           asp-controller="ClassSchedules" asp-action="Index">
                                            <i class="fas fa-calendar-alt"></i> جدول الحصص
                                        </a>
                                        <a class="nav-link @(currentController == "AcademicYears" ? "active" : "")"
                                           asp-controller="AcademicYears" asp-action="Index">
                                            <i class="fas fa-calendar"></i> العام الدراسي
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- القسم 6: الامتحانات (Admin, Principal, Teacher) -->
                        @if (canManageExams)
                        {
                            <div class="sidebar-section">
                                <button class="section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#collapseExams" aria-expanded="@(isExams ? "true" : "false")">
                                    <span class="section-title-text">
                                        <i class="fas fa-pencil-alt"></i> الامتحانات
                                    </span>
                                    <span class="toggle-icon"><i class="fas fa-chevron-down"></i></span>
                                </button>
                                <div class="collapse @(isExams ? "show" : "")" id="collapseExams">
                                    <div class="collapse-content">
                                        <a class="nav-link @(currentController == "Exams" ? "active" : "")"
                                           asp-controller="Exams" asp-action="Index">
                                            <i class="fas fa-pencil-alt"></i> الامتحانات
                                        </a>
                                        <a class="nav-link @(currentController == "ExamResults" ? "active" : "")"
                                           asp-controller="ExamResults" asp-action="Index">
                                            <i class="fas fa-chart-bar"></i> نتائج الامتحانات
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- القسم 7: الحضور (الكل ما عدا الطالب) -->
                        @if (canManageAttendance)
                        {
                            <div class="sidebar-section">
                                <button class="section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAttendance" aria-expanded="@(isAttendance ? "true" : "false")">
                                    <span class="section-title-text">
                                        <i class="fas fa-clipboard-check"></i> الحضور
                                    </span>
                                    <span class="toggle-icon"><i class="fas fa-chevron-down"></i></span>
                                </button>
                                <div class="collapse @(isAttendance ? "show" : "")" id="collapseAttendance">
                                    <div class="collapse-content">
                                        <a class="nav-link @(currentController == "StudentAttendances" ? "active" : "")"
                                           asp-controller="StudentAttendances" asp-action="Index">
                                            <i class="fas fa-check-circle"></i> حضور الطلاب
                                        </a>
                                        <a class="nav-link @(currentController == "EmployeeAttendances" ? "active" : "")"
                                           asp-controller="EmployeeAttendances" asp-action="Index">
                                            <i class="fas fa-clock"></i> حضور الموظفين
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- القسم 8: جهات الاتصال والأدوار (Admin فقط) -->
                        @if (canManageUsers)
                        {
                            <div class="sidebar-section">
                                <button class="section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#collapseContacts" aria-expanded="@(isContacts ? "true" : "false")">
                                    <span class="section-title-text">
                                        <i class="fas fa-address-book"></i> جهات الاتصال
                                    </span>
                                    <span class="toggle-icon"><i class="fas fa-chevron-down"></i></span>
                                </button>
                                <div class="collapse @(isContacts ? "show" : "")" id="collapseContacts">
                                    <div class="collapse-content">
                                        <a class="nav-link @(currentController == "UserContacts" ? "active" : "")"
                                           asp-controller="UserContacts" asp-action="Index">
                                            <i class="fas fa-address-book"></i> جهات الاتصال
                                        </a>
                                        <a class="nav-link @(currentController == "UserRoles" ? "active" : "")"
                                           asp-controller="UserRoles" asp-action="Index">
                                            <i class="fas fa-user-tag"></i> أدوار المستخدمين
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- القسم 9: التقارير (الكل ما عدا الطالب) -->
                        @if (canViewReports)
                        {
                            <div class="sidebar-section">
                                <button class="section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#collapseReports" aria-expanded="@(isReports ? "true" : "false")">
                                    <span class="section-title-text">
                                        <i class="fas fa-file-alt"></i> التقارير
                                    </span>
                                    <span class="toggle-icon"><i class="fas fa-chevron-down"></i></span>
                                </button>
                                <div class="collapse @(isReports ? "show" : "")" id="collapseReports">
                                    <div class="collapse-content">
                                        <a class="nav-link @(currentController == "Reports" ? "active" : "")"
                                           asp-controller="Reports" asp-action="Index">
                                            <i class="fas fa-file-alt"></i> التقارير
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- ⚠️  عرض خاص للطالب -->
                        @if (isStudent)
                        {
                            <div class="sidebar-section">
                                <button class="section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#collapseStudent" aria-expanded="true">
                                    <span class="section-title-text">
                                        <i class="fas fa-user-graduate"></i> حسابي
                                    </span>
                                    <span class="toggle-icon"><i class="fas fa-chevron-down"></i></span>
                                </button>
                                <div class="collapse show" id="collapseStudent">
                                    <div class="collapse-content">
                                        <a class="nav-link" asp-controller="Students" asp-action="MyProfile">
                                            <i class="fas fa-id-card"></i> ملفي الشخصي
                                        </a>
                                        <a class="nav-link" asp-controller="Students" asp-action="MyGrades">
                                            <i class="fas fa-star"></i> درجاتي
                                        </a>
                                        <a class="nav-link" asp-controller="Students" asp-action="MySchedule">
                                            <i class="fas fa-calendar-week"></i> جدولي الدراسي
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- خروج -->
                        <hr class="sidebar-divider" />
                        <div class="sidebar-section">
                            <ul class="nav flex-column">
                                <li class="nav-item">
                                    <a class="nav-link text-danger" asp-controller="Auth" asp-action="Logout">
                                        <i class="fas fa-sign-out-alt"></i> تسجيل الخروج
                                    </a>
                                </li>
                            </ul>
                        </div>

                    </div>
                </div>

                <!-- Main Content -->
                <main class="col-md-10 col-lg-10 main-content">
                    @RenderBody()
                </main>
            }
            else
            {
                <main class="col-12 p-0">
                    @RenderBody()
                </main>
            }

        </div>
    </div>

    <!-- ============================================================ -->
    <!-- ✅ Footer -->
    <!-- ============================================================ -->
    <footer class="footer">
        <div class="container-fluid">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start">
                    <span class="text-muted">
                        &copy; @DateTime.Now.Year <strong>SchoolERP</strong> - نظام إدارة المدارس
                    </span>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <span class="text-muted">
                        <i class="fas fa-clock me-1"></i>
                        <span class="current-time">00:00:00</span>
                        <span class="current-date me-3">00/00/0000</span>
                        <i class="fas fa-code me-1"></i> v2.0
                    </span>
                </div>
            </div>
        </div>
    </footer>

    <!-- ============================================================ -->
    <!-- 📦  السكريبتات -->
    <!-- ============================================================ -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap5.min.js"></script>

    <!-- ============================================================ -->
    <!-- 🛠️  السكريبتات المخصصة (كل ملف في مكانه) -->
    <!-- ============================================================ -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/navbar.js" asp-append-version="true"></script>
    <script src="~/js/sidebar.js" asp-append-version="true"></script>

    @* ✅ سكريبتات خاصة بالصفحة *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>