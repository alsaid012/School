@model IEnumerable<SchoolERP.Application.DTOs.GradeLevels.GradeLevelDto>

@{
    ViewData["Title"] = "الصفوف الدراسية";
    ViewData["PageTitle"] = "إدارة الصفوف الدراسية";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h4 class="mb-0"><i class="fas fa-graduation-cap me-2"></i>@ViewData["PageTitle"]</h4>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>إضافة صف جديد
    </a>
    
</div>
    <!-- ============================================================ -->
    <!-- رسائل التنبيه -->
    <!-- ============================================================ -->
@if (TempData["Success"] != null)
{
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
}

@if (TempData["Error"] != null)
{
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
}

    <!-- ============================================================ -->
    <!-- جدول الصفوف الدراسية -->
    <!-- ============================================================ -->
    <div class="table-responsive">
        <table class="table table-striped table-hover table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th style="width: 50px;">#</th>
                    <th style="min-width: 150px;">اسم الصف</th>
                    <th style="min-width: 100px;">المرحلة</th>
                    <th style="min-width: 140px;">المدرسة</th>
                    <th style="min-width: 100px;">عدد الفصول</th>
                    <th style="min-width: 100px;">عدد المواد</th>
                    <th style="min-width: 100px;">عدد الطلاب</th>
                    <th style="min-width: 100px;">الحالة</th>
                    <th style="min-width: 220px;">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int index = 1;
                    foreach (var grade in Model)
                    {
                        <tr>
                            <td class="text-center">@index</td>
                            <td><strong>@grade.GradeName</strong></td>
                            <td><span class="badge bg-info">@grade.GradeStageName</span></td>
                            <td>@grade.SchoolName</td>
                            <td>@grade.ClassRoomsCount</td>
                            <td>@grade.SubjectsCount</td>
                            <td>@grade.StudentsCount</td>
                            <td>
                                @if (grade.IsActive)
                                {
                                    <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>مفعل</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger"><i class="fas fa-times-circle me-1"></i>غير مفعل</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm flex-wrap gap-1" role="group">
                                    <a asp-action="Details" asp-route-id="@grade.Id" class="btn btn-info btn-sm" title="تفاصيل">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@grade.Id" class="btn btn-warning btn-sm" title="تعديل">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@grade.Id" method="post" style="display:inline;">
                                        <button type="submit" class="btn btn-danger btn-sm" title="حذف" onclick="return confirm('هل أنت متأكد من حذف هذا الصف؟')">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        index++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">
                            <i class="fas fa-graduation-cap fa-2x d-block mb-2"></i>
                            لا يوجد صفوف دراسية
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

