@model SchoolERP.Application.DTOs.GradeLevels.GradeLevelDto

@{
    ViewData["Title"] = "حذف الصف";
    ViewData["PageTitle"] = "حذف الصف";
}

<div class="card shadow-sm">
    <div class="card-header bg-danger text-white">
        <h5 class="mb-0"><i class="fas fa-trash me-2"></i>حذف الصف</h5>
    </div>
    <div class="card-body">
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle me-2"></i>
            <strong>تنبيه!</strong> هل أنت متأكد من حذف هذا الصف؟ هذا الإجراء لا يمكن التراجع عنه.
        </div>

        <dl class="row">
            <dt class="col-sm-3">اسم الصف</dt>
            <dd class="col-sm-9">@Model.GradeName</dd>

            <dt class="col-sm-3">رقم الصف</dt>
            <dd class="col-sm-9">@Model.GradeNumber</dd>

            <dt class="col-sm-3">المرحلة الدراسية</dt>
            <dd class="col-sm-9"><span class="badge bg-info">@Model.GradeStageName</span></dd>

            <dt class="col-sm-3">المدرسة</dt>
            <dd class="col-sm-9">@Model.SchoolName</dd>

            <dt class="col-sm-3">عدد الفصول</dt>
            <dd class="col-sm-9">@Model.ClassRoomsCount</dd>

            <dt class="col-sm-3">عدد الطلاب</dt>
            <dd class="col-sm-9">@Model.StudentsCount</dd>

            <dt class="col-sm-3">الحالة</dt>
            <dd class="col-sm-9">
                @if (Model.IsActive)
                {
                    <span class="badge bg-success">مفعل</span>
                }
                else
                {
                    <span class="badge bg-danger">غير مفعل</span>
                }
            </dd>
        </dl>

        <form method="post" asp-action="Delete" asp-route-id="@Model.Id">
            <button type="submit" class="btn btn-danger">
                <i class="fas fa-trash me-2"></i>تأكيد الحذف
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-right me-2"></i>العودة
            </a>
        </form>
    </div>
</div>