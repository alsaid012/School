@model SchoolERP.Application.DTOs.GradeLevels.UpdateGradeLevelDto

@{
    ViewData["Title"] = "تعديل الصف";
    ViewData["PageTitle"] = "تعديل الصف";
}

<div class="card shadow-sm">
    <div class="card-header bg-warning">
        <h5 class="mb-0"><i class="fas fa-edit me-2"></i>تعديل الصف</h5>
    </div>
    <div class="card-body">
        <form method="post" asp-action="Edit" asp-route-id="@ViewBag.Id">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="GradeName" class="form-label">
                            <i class="fas fa-tag me-1"></i>اسم الصف
                        </label>
                        <input asp-for="GradeName" class="form-control" />
                        <span asp-validation-for="GradeName" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="GradeNumber" class="form-label">
                            <i class="fas fa-sort-numeric-up me-1"></i>رقم الصف
                        </label>
                        <input asp-for="GradeNumber" type="number" class="form-control" />
                        <span asp-validation-for="GradeNumber" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="GradeStage" class="form-label">
                            <i class="fas fa-layer-group me-1"></i>المرحلة الدراسية
                        </label>
                        <select asp-for="GradeStage" class="form-select">
                            <option value="1">ابتدائي</option>
                            <option value="2">إعدادي</option>
                            <option value="3">ثانوي</option>
                        </select>
                        <span asp-validation-for="GradeStage" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="IsActive" class="form-label">
                            <i class="fas fa-power-off me-1"></i>الحالة
                        </label>
                        <select asp-for="IsActive" class="form-select">
                            <option value="true">مفعل</option>
                            <option value="false">غير مفعل</option>
                        </select>
                        <span asp-validation-for="IsActive" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">
                    <i class="fas fa-align-left me-1"></i>الوصف
                </label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <hr />
            <button type="submit" class="btn btn-warning">
                <i class="fas fa-save me-2"></i>تحديث
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-times me-2"></i>إلغاء
            </a>
        </form>
    </div>
</div>