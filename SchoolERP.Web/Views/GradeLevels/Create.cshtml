@model SchoolERP.Application.DTOs.GradeLevels.CreateGradeLevelDto

@{
    ViewData["Title"] = "إنشاء صف جديد";
    ViewData["PageTitle"] = "إنشاء صف جديد";
}

<div class="card shadow-sm">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0"><i class="fas fa-plus me-2"></i>إنشاء صف جديد</h5>
    </div>
    <div class="card-body">
        <form method="post" asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="GradeName" class="form-label">
                            <i class="fas fa-tag me-1"></i>اسم الصف <span class="text-danger">*</span>
                        </label>
                        <input asp-for="GradeName" class="form-control" placeholder="مثال: الصف الأول الثانوي" />
                        <span asp-validation-for="GradeName" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="GradeNumber" class="form-label">
                            <i class="fas fa-sort-numeric-up me-1"></i>رقم الصف <span class="text-danger">*</span>
                        </label>
                        <input asp-for="GradeNumber" type="number" class="form-control" placeholder="مثال: 1" />
                        <span asp-validation-for="GradeNumber" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="GradeStage" class="form-label">
                            <i class="fas fa-layer-group me-1"></i>المرحلة الدراسية <span class="text-danger">*</span>
                        </label>
                        <select asp-for="GradeStage" class="form-select">
                            <option value="1">ابتدائي</option>
                            <option value="2">إعدادي</option>
                            <option value="3">ثانوي</option>
                        </select>
                        <span asp-validation-for="GradeStage" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="SchoolId" class="form-label">
                            <i class="fas fa-school me-1"></i>المدرسة <span class="text-danger">*</span>
                        </label>
                        <select asp-for="SchoolId" class="form-select">
                            <option value="">اختر المدرسة...</option>
                            @if (ViewBag.Schools != null)
                            {
                                foreach (var school in ViewBag.Schools)
                                {
                                    <option value="@school.Id">@school.SchoolName</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="SchoolId" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">
                    <i class="fas fa-align-left me-1"></i>الوصف
                </label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="أدخل وصف الصف"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <hr />
            <button type="submit" class="btn btn-success">
                <i class="fas fa-save me-2"></i>حفظ
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-times me-2"></i>إلغاء
            </a>
        </form>
    </div>
</div>