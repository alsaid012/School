@model SchoolERP.Application.DTOs.Schools.SchoolDetailsDto

@{
    ViewData["Title"] = "تفاصيل المدرسة";
    ViewData["PageTitle"] = "تفاصيل المدرسة";
}

<div class="card shadow-sm">
    <div class="card-header bg-info text-white">
        <h5 class="mb-0"><i class="fas fa-school me-2"></i>@Model.SchoolName</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">اسم المدرسة</dt>
            <dd class="col-sm-9">@Model.SchoolName</dd>

            <dt class="col-sm-3">الكود</dt>
            <dd class="col-sm-9"><span class="badge bg-secondary">@Model.SchoolCode</span></dd>

            <dt class="col-sm-3">النوع</dt>
            <dd class="col-sm-9">@Model.SchoolType</dd>

            <dt class="col-sm-3">الإدارة</dt>
            <dd class="col-sm-9">@Model.DepartmentName</dd>

            <dt class="col-sm-3">المحافظة</dt>
            <dd class="col-sm-9">@Model.GovernorateName</dd>

            <dt class="col-sm-3">المدير</dt>
            <dd class="col-sm-9">@Model.PrincipalName</dd>

            <dt class="col-sm-3">سنة التأسيس</dt>
            <dd class="col-sm-9">@Model.EstablishedYear</dd>

            <dt class="col-sm-3">رقم الهاتف</dt>
            <dd class="col-sm-9">@Model.Phone</dd>

            <dt class="col-sm-3">البريد الإلكتروني</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">العنوان</dt>
            <dd class="col-sm-9">@Model.Address</dd>

            <dt class="col-sm-3">الحالة</dt>
            <dd class="col-sm-9">
                @if (Model.IsActive)
                {
                    <span class="badge bg-success">مفعل</span>
                }
                else
                {
                    <span class="badge bg-danger">غير مفعل</span>
                }
            </dd>

            <dt class="col-sm-3">تاريخ الإنشاء</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>

            <dt class="col-sm-3">آخر تحديث</dt>
            <dd class="col-sm-9">@(Model.UpdatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</dd>
        </dl>

        @if (Model.Statistics != null)
        {
            <hr />
            <h6><i class="fas fa-chart-bar me-2"></i>الإحصائيات</h6>
            <div class="row">
                <div class="col-md-3">
                    <div class="card bg-light">
                        <div class="card-body text-center">
                            <h6 class="text-muted">الطلاب</h6>
                            <h4>@Model.Statistics.TotalStudents</h4>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-light">
                        <div class="card-body text-center">
                            <h6 class="text-muted">المعلمين</h6>
                            <h4>@Model.Statistics.TotalTeachers</h4>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-light">
                        <div class="card-body text-center">
                            <h6 class="text-muted">الموظفين</h6>
                            <h4>@Model.Statistics.TotalEmployees</h4>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-light">
                        <div class="card-body text-center">
                            <h6 class="text-muted">الفصول</h6>
                            <h4>@Model.Statistics.TotalClassRooms</h4>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (Model.GradeLevels != null && Model.GradeLevels.Any())
        {
            <hr />
            <h6><i class="fas fa-graduation-cap me-2"></i>الصفوف الدراسية</h6>
            <ul class="list-group">
                @foreach (var grade in Model.GradeLevels)
                {
                    <li class="list-group-item">@grade.GradeName</li>
                }
            </ul>
        }
    </div>
    <div class="card-footer">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-right me-2"></i>العودة
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
            <i class="fas fa-edit me-2"></i>تعديل
        </a>
    </div>
</div>