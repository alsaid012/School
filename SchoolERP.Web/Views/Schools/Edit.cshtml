@model SchoolERP.Application.DTOs.Schools.UpdateSchoolDto

@{
    ViewData["Title"] = "تعديل المدرسة";
    ViewData["PageTitle"] = "تعديل المدرسة";
}

<div class="card shadow-sm">
    <div class="card-header bg-warning">
        <h5 class="mb-0"><i class="fas fa-edit me-2"></i>تعديل المدرسة</h5>
    </div>
    <div class="card-body">
        <form method="post" asp-action="Edit" asp-route-id="@ViewBag.Id">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="SchoolName" class="form-label">
                            <i class="fas fa-tag me-1"></i>اسم المدرسة
                        </label>
                        <input asp-for="SchoolName" class="form-control" />
                        <span asp-validation-for="SchoolName" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="SchoolCode" class="form-label">
                            <i class="fas fa-barcode me-1"></i>كود المدرسة
                        </label>
                        <input asp-for="SchoolCode" class="form-control" />
                        <span asp-validation-for="SchoolCode" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="SchoolType" class="form-label">
                            <i class="fas fa-tag me-1"></i>نوع المدرسة
                        </label>
                        <select asp-for="SchoolType" class="form-select">
                            <option value="1">عامة</option>
                            <option value="2">خاصة</option>
                            <option value="3">لغات</option>
                            <option value="4">دولية</option>
                        </select>
                        <span asp-validation-for="SchoolType" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="DepartmentId" class="form-label">
                            <i class="fas fa-sitemap me-1"></i>الإدارة
                        </label>
                        <select asp-for="DepartmentId" class="form-select">
                            <option value="">اختر الإدارة...</option>
                            @if (ViewBag.Departments != null)
                            {
                                foreach (var dept in ViewBag.Departments)
                                {
                                    if (Model.DepartmentId == dept.Id)
                                    {
                                        <option value="@dept.Id" selected>@dept.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@dept.Id">@dept.Name</option>
                                    }
                                }
                            }
                        </select>
                        <span asp-validation-for="DepartmentId" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="PrincipalName" class="form-label">
                            <i class="fas fa-user-tie me-1"></i>اسم المدير
                        </label>
                        <input asp-for="PrincipalName" class="form-control" />
                        <span asp-validation-for="PrincipalName" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="EstablishedYear" class="form-label">
                            <i class="fas fa-calendar me-1"></i>سنة التأسيس
                        </label>
                        <input asp-for="EstablishedYear" type="number" class="form-control" />
                        <span asp-validation-for="EstablishedYear" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Phone" class="form-label">
                            <i class="fas fa-phone me-1"></i>رقم الهاتف
                        </label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">
                            <i class="fas fa-envelope me-1"></i>البريد الإلكتروني
                        </label>
                        <input asp-for="Email" type="email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Address" class="form-label">
                    <i class="fas fa-home me-1"></i>العنوان
                </label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="IsActive" class="form-label">
                    <i class="fas fa-power-off me-1"></i>الحالة
                </label>
                <select asp-for="IsActive" class="form-select">
                    <option value="true">مفعل</option>
                    <option value="false">غير مفعل</option>
                </select>
                <span asp-validation-for="IsActive" class="text-danger"></span>
            </div>

            <hr />
            <button type="submit" class="btn btn-warning">
                <i class="fas fa-save me-2"></i>تحديث
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-times me-2"></i>إلغاء
            </a>
        </form>
    </div>
</div>