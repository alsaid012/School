@model SchoolERP.Web.ViewModels.UserRoles.UserRoleIndexViewModel

@{
    ViewData["Title"] = "أدوار المستخدمين";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <i class="fas fa-user-tag text-primary"></i>
            أدوار المستخدمين
        </h1>
        <div>
            <a asp-action="Create" class="btn btn-success btn-lg">
                <i class="fas fa-plus-circle"></i>
                إضافة دور جديد
            </a>
            <a asp-action="Statistics" class="btn btn-info btn-lg ms-2">
                <i class="fas fa-chart-pie"></i>
                إحصائيات
            </a>
        </div>
    </div>

    <!-- فلترة حسب المستخدم -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-bold">
                        <i class="fas fa-user"></i> المستخدم
                    </label>
                    <select name="userId" class="form-select" onchange="this.form.submit()">
                        <option value="">-- جميع المستخدمين --</option>
                        @foreach (var user in Model.Users)
                        {
                            <option value="@user.Value" selected="@user.Selected">@user.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <a asp-action="Index" class="btn btn-secondary w-100">
                        <i class="fas fa-undo"></i> إلغاء الفلترة
                    </a>
                </div>
                <div class="col-md-6 text-end">
                    <span class="badge bg-primary fs-6">@Model.TotalUsers مستخدم</span>
                    <span class="badge bg-success fs-6 ms-2">@Model.UsersWithRoles.TotalItemCount مستخدم معروض</span>
                </div>
            </form>
        </div>
    </div>

    <!-- عرض المستخدمين مع أدوارهم -->
    @if (Model.UsersWithRoles != null && Model.UsersWithRoles.Any())
    {
        foreach (var group in Model.UsersWithRoles)
        {
            <div class="card shadow-sm mb-3 border-@(group.HasPrimaryRole ? "success" : "secondary")">
                <div class="card-header @(group.HasPrimaryRole ? "bg-success" : "bg-secondary") text-white d-flex justify-content-between align-items-center">
                    <div>
                        <i class="fas fa-user"></i>
                        <strong>@group.UserName</strong>
                        <span class="badge bg-light text-dark ms-2">@group.RolesCount دور</span>
                        @if (group.HasPrimaryRole)
                        {
                            <span class="badge bg-warning text-dark ms-2">
                                <i class="fas fa-star"></i> له دور أساسي
                            </span>
                        }
                    </div>
                    <div>
                        <a asp-action="Create" asp-route-userId="@group.UserId" class="btn btn-sm btn-light">
                            <i class="fas fa-plus"></i> إضافة دور
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>نوع الدور</th>
                                    <th>أساسي</th>
                                    <th>تاريخ البداية</th>
                                    <th>تاريخ النهاية</th>
                                    <th>الحالة</th>
                                    <th class="text-center">الإجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int index = 1;
                                    foreach (var item in group.Roles)
                                    {
                                        <tr>
                                            <td>@index</td>
                                            <td>
                                                <span class="badge bg-info">@item.RoleTypeName</span>
                                            </td>
                                            <td>
                                                @if (item.IsPrimary)
                                                {
                                                    <span class="badge bg-success">
                                                        <i class="fas fa-star"></i> أساسي
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">ثانوي</span>
                                                }
                                            </td>
                                            <td>
                                                @if (item.StartDate.HasValue)
                                                {
                                                    <span class="badge bg-secondary">@item.StartDate.Value.ToString("yyyy/MM/dd")</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                @if (item.EndDate.HasValue)
                                                {
                                                    <span class="badge bg-warning text-dark">@item.EndDate.Value.ToString("yyyy/MM/dd")</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                @if (item.IsActive)
                                                {
                                                    <span class="badge bg-success">مفعل</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">غير مفعل</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group" role="group">
                                                    <a asp-action="Details" asp-route-id="@item.Id"
                                                       class="btn btn-sm btn-info" title="تفاصيل">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a asp-action="Edit" asp-route-id="@item.Id"
                                                       class="btn btn-sm btn-warning" title="تعديل">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    @if (!item.IsPrimary)
                                                    {
                                                        <button type="button"
                                                                class="btn btn-sm btn-success"
                                                                onclick="setPrimary(@item.Id, @item.UserId)"
                                                                title="تعيين كأساسي">
                                                            <i class="fas fa-star"></i>
                                                        </button>
                                                    }
                                                    <button type="button"
                                                            class="btn btn-sm btn-danger"
                                                            onclick="deleteItem(@item.Id)"
                                                            title="حذف">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                        index++;
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        <!-- ✅ أزرار الترقيم (Pagination) -->
        <div class="d-flex justify-content-between align-items-center mt-4">
            <div>
                <span class="text-muted">
                    عرض @((Model.UsersWithRoles.PageNumber - 1) * Model.UsersWithRoles.PageSize + 1)
                    إلى @(Math.Min(Model.UsersWithRoles.PageNumber * Model.UsersWithRoles.PageSize, Model.UsersWithRoles.TotalItemCount))
                    من @Model.UsersWithRoles.TotalItemCount مستخدم
                </span>
            </div>
            <div>
                <ul class="pagination mb-0">
                    @if (Model.UsersWithRoles.HasPreviousPage)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.UsersWithRoles.PageNumber - 1)" asp-route-userId="@Model.SelectedUserId">
                                <i class="fas fa-chevron-right"></i> السابق
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link"><i class="fas fa-chevron-right"></i> السابق</span>
                        </li>
                    }

                    @for (int i = 1; i <= Model.UsersWithRoles.PageCount; i++)
                    {
                        if (i == Model.UsersWithRoles.PageNumber)
                        {
                            <li class="page-item active">
                                <span class="page-link">@i</span>
                            </li>
                        }
                        else
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-userId="@Model.SelectedUserId">@i</a>
                            </li>
                        }
                    }

                    @if (Model.UsersWithRoles.HasNextPage)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.UsersWithRoles.PageNumber + 1)" asp-route-userId="@Model.SelectedUserId">
                                التالي <i class="fas fa-chevron-left"></i>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link">التالي <i class="fas fa-chevron-left"></i></span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body text-center text-muted py-5">
                <i class="fas fa-user-tag fa-3x d-block mb-3"></i>
                <h5>لا توجد أدوار لعرضها</h5>
                <a asp-action="Create" class="btn btn-primary mt-3">
                    <i class="fas fa-plus-circle"></i> إضافة دور جديد
                </a>
            </div>
        </div>
    }
</div>

<!-- نماذج مخفية -->
<form id="deleteForm" asp-action="Delete" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" id="deleteId" name="id" value="" />
</form>

<form id="setPrimaryForm" asp-action="SetPrimary" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" id="setPrimaryId" name="id" value="" />
    <input type="hidden" id="setPrimaryUserId" name="userId" value="" />
</form>

@section Scripts {
    <script>
        function deleteItem(id) {
            if (confirm('هل أنت متأكد من حذف هذا الدور؟')) {
                document.getElementById('deleteId').value = id;
                document.getElementById('deleteForm').submit();
            }
        }

        function setPrimary(id, userId) {
            if (confirm('هل أنت متأكد من تعيين هذا الدور كأساسي؟')) {
                document.getElementById('setPrimaryId').value = id;
                document.getElementById('setPrimaryUserId').value = userId;
                document.getElementById('setPrimaryForm').submit();
            }
        }
    </script>
}