@model SchoolERP.Web.ViewModels.UserContacts.UserContactCreateViewModel

@{
    ViewData["Title"] = "إضافة جهة اتصال جديدة";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <i class="fas fa-plus-circle text-success"></i>
            إضافة جهة اتصال جديدة
        </h1>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-right"></i> العودة للقائمة
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-success text-white">
            <i class="fas fa-plus"></i>
            بيانات جهة الاتصال الجديدة
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row">
                    <!-- المستخدم -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Contact.UserId" class="form-label fw-bold">
                            <i class="fas fa-user text-primary"></i>
                            المستخدم
                        </label>
                        <select asp-for="Contact.UserId" class="form-select form-select-lg" asp-items="Model.Users">
                            <option value="">-- اختر المستخدم --</option>
                        </select>
                        <span asp-validation-for="Contact.UserId" class="text-danger"></span>
                    </div>

                    <!-- نوع جهة الاتصال -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Contact.ContactType" class="form-label fw-bold">
                            <i class="fas fa-tag text-info"></i>
                            نوع جهة الاتصال
                        </label>
                        <select asp-for="Contact.ContactType" class="form-select form-select-lg" asp-items="Model.ContactTypes">
                            <option value="">-- اختر النوع --</option>
                        </select>
                        <span asp-validation-for="Contact.ContactType" class="text-danger"></span>
                    </div>

                    <!-- قيمة جهة الاتصال -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Contact.ContactValue" class="form-label fw-bold">
                            <i class="fas fa-link text-warning"></i>
                            قيمة جهة الاتصال
                        </label>
                        <input asp-for="Contact.ContactValue" class="form-control form-control-lg" placeholder="مثال: 01001234567 أو example@email.com" />
                        <span asp-validation-for="Contact.ContactValue" class="text-danger"></span>
                    </div>

                    <!-- جهة اتصال أساسية -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Contact.IsPrimary" class="form-label fw-bold">
                            <i class="fas fa-star text-warning"></i>
                            @Html.DisplayNameFor(m => m.Contact.IsPrimary)
                        </label>
                        <div class="form-check form-switch mt-2">
                            <input asp-for="Contact.IsPrimary" class="form-check-input" id="isPrimarySwitch" />
                            <label class="form-check-label fw-bold" for="isPrimarySwitch">
                                @if (Model.Contact.IsPrimary)
                                {
                                    <span class="text-success"><i class="fas fa-star"></i> أساسي</span>
                                }
                                else
                                {
                                    <span class="text-secondary"><i class="fas fa-circle"></i> ثانوي</span>
                                }
                            </label>
                        </div>
                        <small class="text-muted">جهة الاتصال الأساسية هي التي سيتم استخدامها افتراضياً</small>
                    </div>

                    <!-- تم التحقق -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Contact.IsVerified" class="form-label fw-bold">
                            <i class="fas fa-check-circle text-success"></i>
                            @Html.DisplayNameFor(m => m.Contact.IsVerified)
                        </label>
                        <div class="form-check form-switch mt-2">
                            <input asp-for="Contact.IsVerified" class="form-check-input" id="isVerifiedSwitch" />
                            <label class="form-check-label fw-bold" for="isVerifiedSwitch">
                                @if (Model.Contact.IsVerified)
                                {
                                    <span class="text-success"><i class="fas fa-check-circle"></i> موثق</span>
                                }
                                else
                                {
                                    <span class="text-secondary"><i class="fas fa-circle"></i> غير موثق</span>
                                }
                            </label>
                        </div>
                        <small class="text-muted">تحديد أن جهة الاتصال موثقة (تم التحقق منها)</small>
                    </div>

                    <!-- ملاحظات -->
                    <div class="col-md-12 mb-3">
                        <label asp-for="Contact.Notes" class="form-label fw-bold">
                            <i class="fas fa-sticky-note text-muted"></i>
                            ملاحظات (اختياري)
                        </label>
                        <textarea asp-for="Contact.Notes" class="form-control" rows="3" placeholder="أدخل أي ملاحظات إضافية..."></textarea>
                        <span asp-validation-for="Contact.Notes" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-4 d-flex gap-2 border-top pt-3">
                    <button type="submit" class="btn btn-success btn-lg">
                        <i class="fas fa-save"></i> حفظ جهة الاتصال
                    </button>
                    <a asp-action="Index" class="btn btn-secondary btn-lg">
                        <i class="fas fa-times"></i> إلغاء
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            // ✅ تحديث نص Switches عند التغيير
            $('#isPrimarySwitch').on('change', function () {
                var label = $(this).closest('.form-check').find('.form-check-label');
                if ($(this).is(':checked')) {
                    label.html('<span class="text-success"><i class="fas fa-star"></i> أساسي</span>');
                } else {
                    label.html('<span class="text-secondary"><i class="fas fa-circle"></i> ثانوي</span>');
                }
            });

            $('#isVerifiedSwitch').on('change', function () {
                var label = $(this).closest('.form-check').find('.form-check-label');
                if ($(this).is(':checked')) {
                    label.html('<span class="text-success"><i class="fas fa-check-circle"></i> موثق</span>');
                } else {
                    label.html('<span class="text-secondary"><i class="fas fa-circle"></i> غير موثق</span>');
                }
            });
        });
    </script>
}