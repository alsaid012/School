@model SchoolERP.Application.DTOs.UserContacts.UserContactDto

@{
    ViewData["Title"] = "تفاصيل جهة الاتصال";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <i class="fas fa-address-book text-info"></i>
            تفاصيل جهة الاتصال
        </h1>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="fas fa-edit"></i> تعديل
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-right"></i> العودة للقائمة
            </a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-info text-white">
            <i class="fas fa-info-circle"></i>
            معلومات جهة الاتصال
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">
                            <i class="fas fa-user text-primary"></i> المستخدم
                        </dt>
                        <dd class="col-sm-8">
                            <strong>@Model.UserName</strong>
                        </dd>

                        <dt class="col-sm-4">
                            <i class="fas fa-tag text-info"></i> النوع
                        </dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-info">@Model.ContactTypeName</span>
                        </dd>

                        <dt class="col-sm-4">
                            <i class="fas fa-link text-warning"></i> القيمة
                        </dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-success">@Model.ContactValue</span>
                        </dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">
                            <i class="fas fa-star text-warning"></i> أساسي
                        </dt>
                        <dd class="col-sm-8">
                            @if (Model.IsPrimary)
                            {
                                <span class="badge bg-success">
                                    <i class="fas fa-check"></i> نعم
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">لا</span>
                            }
                        </dd>

                        <dt class="col-sm-4">
                            <i class="fas fa-check-circle text-success"></i> موثق
                        </dt>
                        <dd class="col-sm-8">
                            @if (Model.IsVerified)
                            {
                                <span class="badge bg-success">
                                    <i class="fas fa-check"></i> نعم
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">لا</span>
                            }
                        </dd>

                        <dt class="col-sm-4">
                            <i class="fas fa-toggle-on text-success"></i> الحالة
                        </dt>
                        <dd class="col-sm-8">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">مفعل</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">غير مفعل</span>
                            }
                        </dd>
                    </dl>
                </div>

                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="col-md-12 mt-3">
                        <hr />
                        <strong><i class="fas fa-sticky-note text-muted"></i> ملاحظات:</strong>
                        <p class="mt-2 p-3 bg-light rounded">@Model.Notes</p>
                    </div>
                }

                <div class="col-md-12 mt-3">
                    <hr />
                    <div class="text-muted small">
                        <i class="fas fa-calendar-plus"></i> تاريخ الإنشاء: @Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")
                        @if (Model.UpdatedAt.HasValue)
                        {
                            <span class="ms-3">
                                <i class="fas fa-calendar-edit"></i> آخر تحديث: @Model.UpdatedAt.Value.ToString("yyyy/MM/dd HH:mm")
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>