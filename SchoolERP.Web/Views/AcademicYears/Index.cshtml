@model IEnumerable<SchoolERP.Application.DTOs.AcademicYears.AcademicYearDto>

@{
    ViewData["Title"] = "الأعوام الدراسية";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <i class="fas fa-calendar-alt text-primary"></i>
            الأعوام الدراسية
        </h1>
        <a asp-action="Create" class="btn btn-primary btn-lg">
            <i class="fas fa-plus-circle"></i>
            إضافة عام دراسي جديد
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <i class="fas fa-list"></i>
            قائمة الأعوام الدراسية
            <span class="badge bg-light text-primary float-end">
                @Model.Count() عام
            </span>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover table-striped" id="academicYearsTable">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>اسم العام الدراسي</th>
                            <th>المدرسة</th>
                            <th>تاريخ البداية</th>
                            <th>تاريخ النهاية</th>
                            <th>عدد الطلاب</th>
                            <th>الحالي</th>
                            <th>الحالة</th>
                            <th class="text-center">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            int index = 1;
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@index</td>
                                    <td>
                                        <strong>@item.YearName</strong>
                                    </td>
                                    <td>@item.SchoolName</td>
                                    <td>
                                        <span class="badge bg-secondary">@item.StartDate.ToString("yyyy/MM/dd")</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@item.EndDate.ToString("yyyy/MM/dd")</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary">@item.StudentsCount</span>
                                    </td>
                                    <td>
                                        @if (item.IsCurrent)
                                        {
                                            <span class="badge bg-success">
                                                <i class="fas fa-check-circle"></i> حالي
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">سابق</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                <i class="fas fa-check"></i> مفعل
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                <i class="fas fa-times"></i> غير مفعل
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-info" title="تفاصيل">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-warning" title="تعديل">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            @if (!item.IsCurrent)
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-success"
                                                        onclick="setCurrent(@item.Id)"
                                                        title="تعيين كعام حالي">
                                                    <i class="fas fa-check-double"></i>
                                                </button>
                                            }
                                            <a asp-action="Statistics" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-primary" title="إحصائيات">
                                                <i class="fas fa-chart-pie"></i>
                                            </a>
                                            <button type="button"
                                                    class="btn btn-sm btn-danger"
                                                    onclick="deleteItem(@item.Id)"
                                                    title="حذف">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted py-4">
                                    <i class="fas fa-calendar-times fa-2x d-block mb-2"></i>
                                    لا توجد أعوام دراسية لعرضها
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- نماذج مخفية -->
<form id="deleteForm" asp-action="Delete" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" id="deleteId" name="id" value="" />
</form>

<form id="setCurrentForm" asp-action="SetCurrent" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" id="setCurrentId" name="id" value="" />
</form>

@section Scripts {
    <script>
        function deleteItem(id) {
            if (confirm('هل أنت متأكد من حذف هذا العام الدراسي؟')) {
                document.getElementById('deleteId').value = id;
                document.getElementById('deleteForm').submit();
            }
        }

        function setCurrent(id) {
            if (confirm('هل أنت متأكد من تعيين هذا العام كعام دراسي حالي؟')) {
                document.getElementById('setCurrentId').value = id;
                document.getElementById('setCurrentForm').submit();
            }
        }

        $(document).ready(function () {
            $('#academicYearsTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.4/i18n/ar.json'
                },
                order: [[4, 'desc']],
                pageLength: 25
            });
        });
    </script>
}