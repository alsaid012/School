@model SchoolERP.Application.DTOs.Governorates.CreateGovernorateDto

@{
    ViewData["Title"] = "إنشاء محافظة جديدة";
    ViewData["PageTitle"] = "إنشاء محافظة جديدة";
}

<div class="card shadow-sm">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0"><i class="fas fa-plus me-2"></i>إنشاء محافظة جديدة</h5>
    </div>
    <div class="card-body">
        <form method="post" asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">
                            <i class="fas fa-tag me-1"></i>اسم المحافظة <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Name" class="form-control" placeholder="أدخل اسم المحافظة" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Code" class="form-label">
                            <i class="fas fa-barcode me-1"></i>الكود <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Code" class="form-control" placeholder="أدخل كود المحافظة" />
                        <span asp-validation-for="Code" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <hr />
            <button type="submit" class="btn btn-success">
                <i class="fas fa-save me-2"></i>حفظ
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-times me-2"></i>إلغاء
            </a>
        </form>
    </div>
</div>