@model SchoolERP.Application.DTOs.Employees.EmployeeDetailsDto

@{
    ViewData["Title"] = "تفاصيل الموظف";
    ViewData["PageTitle"] = "تفاصيل الموظف";
}

<div class="card shadow-sm">
    <div class="card-header bg-info text-white">
        <h5 class="mb-0"><i class="fas fa-user-tie me-2"></i>@Model.FullName</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">كود الموظف</dt>
            <dd class="col-sm-9"><strong>@Model.EmployeeCode</strong></dd>

            <dt class="col-sm-3">اسم الموظف</dt>
            <dd class="col-sm-9">@Model.FullName</dd>

            <dt class="col-sm-3">البريد الإلكتروني</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">رقم الهاتف</dt>
            <dd class="col-sm-9">@Model.PhoneNumber</dd>

            <dt class="col-sm-3">المسمى الوظيفي</dt>
            <dd class="col-sm-9">@Model.JobTitle</dd>

            <dt class="col-sm-3">القسم</dt>
            <dd class="col-sm-9">@Model.Department</dd>

            <dt class="col-sm-3">تاريخ التعيين</dt>
            <dd class="col-sm-9">@Model.HireDate.ToString("yyyy-MM-dd")</dd>

            <dt class="col-sm-3">الراتب</dt>
            <dd class="col-sm-9">@Model.Salary</dd>

            <dt class="col-sm-3">المدرسة</dt>
            <dd class="col-sm-9">@Model.SchoolName</dd>

            <dt class="col-sm-3">الحالة</dt>
            <dd class="col-sm-9">
                @if (Model.IsActive)
                {
                    <span class="badge bg-success">نشط</span>
                }
                else
                {
                    <span class="badge bg-danger">غير نشط</span>
                }
            </dd>
        </dl>

        @if (Model.Statistics != null)
        {
            <hr />
            <h6><i class="fas fa-chart-bar me-2"></i>الإحصائيات</h6>
            <div class="row">
                <div class="col-md-3">
                    <div class="card bg-light">
                        <div class="card-body text-center">
                            <h6 class="text-muted">سنوات الخبرة</h6>
                            <h4>@Model.Statistics.YearsOfExperience</h4>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-light">
                        <div class="card-body text-center">
                            <h6 class="text-muted">أيام الحضور</h6>
                            <h4>@Model.Statistics.PresentDays</h4>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-light">
                        <div class="card-body text-center">
                            <h6 class="text-muted">نسبة الحضور</h6>
                            <h4>@Model.Statistics.AttendancePercentage.ToString("F1")%</h4>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-light">
                        <div class="card-body text-center">
                            <h6 class="text-muted">تقييم الأداء</h6>
                            <h4>@Model.Statistics.PerformanceRating.ToString("F1")</h4>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="card-footer">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-right me-2"></i>العودة
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
            <i class="fas fa-edit me-2"></i>تعديل
        </a>
    </div>
</div>