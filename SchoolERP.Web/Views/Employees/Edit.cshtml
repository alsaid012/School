@model SchoolERP.Application.DTOs.Employees.UpdateEmployeeDto

@{
    ViewData["Title"] = "تعديل الموظف";
    ViewData["PageTitle"] = "تعديل الموظف";
}

<div class="card shadow-sm">
    <div class="card-header bg-warning">
        <h5 class="mb-0"><i class="fas fa-edit me-2"></i>تعديل الموظف</h5>
    </div>
    <div class="card-body">
        <form method="post" asp-action="Edit" asp-route-id="@ViewBag.Id">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="JobTitle" class="form-label">
                            <i class="fas fa-briefcase me-1"></i>المسمى الوظيفي
                        </label>
                        <input asp-for="JobTitle" class="form-control" />
                        <span asp-validation-for="JobTitle" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Department" class="form-label">
                            <i class="fas fa-building me-1"></i>القسم
                        </label>
                        <input asp-for="Department" class="form-control" />
                        <span asp-validation-for="Department" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Salary" class="form-label">
                            <i class="fas fa-money-bill me-1"></i>الراتب
                        </label>
                        <input asp-for="Salary" type="number" class="form-control" />
                        <span asp-validation-for="Salary" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="IsActive" class="form-label">
                            <i class="fas fa-power-off me-1"></i>الحالة
                        </label>
                        <select asp-for="IsActive" class="form-select">
                            <option value="true">مفعل</option>
                            <option value="false">غير مفعل</option>
                        </select>
                        <span asp-validation-for="IsActive" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <hr />
            <button type="submit" class="btn btn-warning">
                <i class="fas fa-save me-2"></i>تحديث
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-times me-2"></i>إلغاء
            </a>
        </form>
    </div>
</div>