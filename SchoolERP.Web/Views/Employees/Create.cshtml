@model SchoolERP.Application.DTOs.Employees.CreateEmployeeDto

@{
    ViewData["Title"] = "إنشاء موظف جديد";
    ViewData["PageTitle"] = "إنشاء موظف جديد";
}

<div class="card shadow-sm">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0"><i class="fas fa-user-plus me-2"></i>إنشاء موظف جديد</h5>
    </div>
    <div class="card-body">
        <form method="post" asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="EmployeeCode" class="form-label">
                            <i class="fas fa-barcode me-1"></i>كود الموظف <span class="text-danger">*</span>
                        </label>
                        <input asp-for="EmployeeCode" class="form-control" placeholder="مثال: EMP-2024-001" />
                        <span asp-validation-for="EmployeeCode" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="UserId" class="form-label">
                            <i class="fas fa-user me-1"></i>المستخدم <span class="text-danger">*</span>
                        </label>
                        <select asp-for="UserId" class="form-select">
                            <option value="">اختر المستخدم...</option>
                            @if (ViewBag.Users != null)
                            {
                                foreach (var user in ViewBag.Users)
                                {
                                    <option value="@user.Id">@user.FullName (@user.Username)</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="UserId" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="JobTitle" class="form-label">
                            <i class="fas fa-briefcase me-1"></i>المسمى الوظيفي <span class="text-danger">*</span>
                        </label>
                        <input asp-for="JobTitle" class="form-control" placeholder="مثال: مدير شؤون الطلاب" />
                        <span asp-validation-for="JobTitle" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Department" class="form-label">
                            <i class="fas fa-building me-1"></i>القسم
                        </label>
                        <input asp-for="Department" class="form-control" placeholder="مثال: شؤون الطلاب" />
                        <span asp-validation-for="Department" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="HireDate" class="form-label">
                            <i class="fas fa-calendar me-1"></i>تاريخ التعيين <span class="text-danger">*</span>
                        </label>
                        <input asp-for="HireDate" type="date" class="form-control" />
                        <span asp-validation-for="HireDate" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Salary" class="form-label">
                            <i class="fas fa-money-bill me-1"></i>الراتب
                        </label>
                        <input asp-for="Salary" type="number" class="form-control" placeholder="مثال: 5000" />
                        <span asp-validation-for="Salary" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <hr />
            <button type="submit" class="btn btn-success">
                <i class="fas fa-save me-2"></i>حفظ
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-times me-2"></i>إلغاء
            </a>
        </form>
    </div>
</div>