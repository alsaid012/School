@model SchoolERP.Web.ViewModels.ExamResults.ExamResultEditViewModel

@{
    ViewData["Title"] = "تعديل نتيجة";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <i class="fas fa-edit text-warning"></i>
            تعديل نتيجة
        </h1>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-right"></i> العودة للقائمة
        </a>
    </div>

    <!-- معلومات النتيجة -->
    <div class="card shadow-sm mb-4 border-info">
        <div class="card-header bg-info text-white">
            <i class="fas fa-info-circle"></i>
            معلومات النتيجة (للقراءة فقط)
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <strong><i class="fas fa-user-graduate"></i> الطالب:</strong>
                    <span class="badge bg-primary fs-6">@Model.DisplayInfo.StudentName</span>
                </div>
                <div class="col-md-3">
                    <strong><i class="fas fa-id-card"></i> كود الطالب:</strong>
                    <span class="badge bg-secondary fs-6">@Model.DisplayInfo.StudentCode</span>
                </div>
                <div class="col-md-3">
                    <strong><i class="fas fa-file-alt"></i> الامتحان:</strong>
                    <span class="badge bg-success fs-6">@Model.DisplayInfo.ExamName</span>
                </div>
                <div class="col-md-3">
                    <strong><i class="fas fa-book"></i> المادة:</strong>
                    <span class="badge bg-warning text-dark fs-6">@Model.DisplayInfo.SubjectName</span>
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-md-3">
                    <strong><i class="fas fa-chalkboard"></i> الفصل:</strong>
                    <span class="badge bg-dark fs-6">@Model.DisplayInfo.ClassRoomName</span>
                </div>
                <div class="col-md-3">
                    <strong><i class="fas fa-calendar"></i> التاريخ:</strong>
                    <span class="badge bg-info fs-6">@Model.DisplayInfo.ExamDate.ToString("yyyy/MM/dd")</span>
                </div>
                <div class="col-md-3">
                    <strong><i class="fas fa-star"></i> الدرجة النهائية:</strong>
                    <span class="badge bg-warning text-dark fs-6">@Model.DisplayInfo.MaxScore</span>
                </div>
                <div class="col-md-3">
                    <strong><i class="fas fa-percent"></i> النسبة:</strong>
                    <span class="badge bg-info fs-6">@Model.DisplayInfo.Percentage.ToString("0.0")%</span>
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-md-3">
                    <strong><i class="fas fa-star"></i> التقدير:</strong>
                    <span class="badge bg-primary fs-6">@Model.DisplayInfo.Grade</span>
                </div>
                <div class="col-md-3">
                    <strong><i class="fas fa-check-circle"></i> الحالة:</strong>
                    @if (Model.DisplayInfo.IsPassed)
                    {
                        <span class="badge bg-success fs-6">ناجح</span>
                    }
                    else
                    {
                        <span class="badge bg-danger fs-6">راسب</span>
                    }
                </div>
                <div class="col-md-3">
                    <strong><i class="fas fa-star"></i> الدرجة الحالية:</strong>
                    <span class="badge bg-primary fs-6">@Model.DisplayInfo.CurrentScore</span>
                </div>
            </div>
        </div>
    </div>

    <!-- نموذج التعديل -->
    <div class="card shadow-sm">
        <div class="card-header bg-warning text-white">
            <i class="fas fa-edit"></i>
            تعديل النتيجة
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row">
                    <!-- الدرجة -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="ExamResult.Score" class="form-label fw-bold">
                            <i class="fas fa-star text-warning"></i>
                            الدرجة
                        </label>
                        <input asp-for="ExamResult.Score" type="number" min="0" max="@Model.DisplayInfo.MaxScore" class="form-control form-control-lg" />
                        <span asp-validation-for="ExamResult.Score" class="text-danger"></span>
                        <small class="text-muted">الدرجة النهائية: @Model.DisplayInfo.MaxScore</small>
                    </div>

                    <!-- الحالة -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="ExamResult.IsActive" class="form-label fw-bold">
                            <i class="fas fa-toggle-on text-success"></i>
                            الحالة
                        </label>
                        <div class="form-check form-switch mt-2">
                            <input asp-for="ExamResult.IsActive" class="form-check-input" id="isActiveSwitch" checked="@(Model.ExamResult.IsActive)" />
                            <label class="form-check-label fw-bold" for="isActiveSwitch">
                                @if (Model.ExamResult.IsActive)
                                {
                                    <span class="text-success"><i class="fas fa-check-circle"></i> مفعل</span>
                                }
                                else
                                {
                                    <span class="text-danger"><i class="fas fa-times-circle"></i> غير مفعل</span>
                                }
                            </label>
                        </div>
                    </div>

                    <!-- ملاحظات -->
                    <div class="col-md-12 mb-3">
                        <label asp-for="ExamResult.Remarks" class="form-label fw-bold">
                            <i class="fas fa-sticky-note text-muted"></i>
                            ملاحظات (اختياري)
                        </label>
                        <textarea asp-for="ExamResult.Remarks" class="form-control" rows="3" placeholder="أدخل أي ملاحظات إضافية..."></textarea>
                        <span asp-validation-for="ExamResult.Remarks" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-4 d-flex gap-2 border-top pt-3">
                    <button type="submit" class="btn btn-warning btn-lg">
                        <i class="fas fa-save"></i> تحديث النتيجة
                    </button>
                    <a asp-action="Index" class="btn btn-secondary btn-lg">
                        <i class="fas fa-times"></i> إلغاء
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            $('#isActiveSwitch').on('change', function () {
                var label = $(this).closest('.form-check').find('.form-check-label');
                if ($(this).is(':checked')) {
                    label.html('<span class="text-success"><i class="fas fa-check-circle"></i> مفعل</span>');
                } else {
                    label.html('<span class="text-danger"><i class="fas fa-times-circle"></i> غير مفعل</span>');
                }
            });
        });
    </script>
}