@model SchoolERP.Web.ViewModels.Exams.ExamIndexViewModel

@{
    ViewData["Title"] = "الامتحانات";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <i class="fas fa-file-alt text-primary"></i>
            الامتحانات
        </h1>
        <a asp-action="Create" class="btn btn-primary btn-lg">
            <i class="fas fa-plus-circle"></i>
            إضافة امتحان جديد
        </a>
    </div>

    <!-- فلترة -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-bold">
                        <i class="fas fa-calendar"></i> السنة الدراسية
                    </label>
                    <select name="academicYearId" class="form-select">
                        <option value="">-- جميع السنوات --</option>
                        @foreach (var year in Model.AcademicYears)
                        {
                            <option value="@year.Value" selected="@year.Selected">@year.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-filter"></i> تصفية
                    </button>
                </div>
                <div class="col-md-2">
                    <a asp-action="Index" class="btn btn-secondary w-100">
                        <i class="fas fa-undo"></i> إلغاء
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- جدول الامتحانات -->
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <i class="fas fa-list"></i>
            قائمة الامتحانات
            <span class="badge bg-light text-primary float-end">
                @Model.Exams.Count() امتحان
            </span>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover table-striped" id="examsTable">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>اسم الامتحان</th>
                            <th>النوع</th>
                            <th>المادة</th>
                            <th>الفصل</th>
                            <th>التاريخ</th>
                            <th>الوقت</th>
                            <th>الدرجة</th>
                            <th>الطلاب</th>
                            <th>المتوسط</th>
                            <th>الحالة</th>
                            <th class="text-center">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Exams != null && Model.Exams.Any())
                        {
                            int index = 1;
                            foreach (var item in Model.Exams)
                            {
                                <tr>
                                    <td>@index</td>
                                    <td>
                                        <strong>@item.ExamName</strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@item.ExamTypeName</span>
                                    </td>
                                    <td>@item.SubjectName</td>
                                    <td>@item.ClassRoomName</td>
                                    <td>
                                        <span class="badge bg-secondary">@item.ExamDate.ToString("yyyy/MM/dd")</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-success">
                                            @item.StartTime.ToString("hh\\:mm") - @item.EndTime.ToString("hh\\:mm")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-warning text-dark">@item.MaxScore</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary">@item.StudentsCount</span>
                                    </td>
                                    <td>
                                        @if (item.AverageScore.HasValue)
                                        {
                                            <span class="badge bg-dark">@item.AverageScore.Value.ToString("0.00")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                <i class="fas fa-check"></i> مفعل
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                <i class="fas fa-times"></i> غير مفعل
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-info" title="تفاصيل">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-warning" title="تعديل">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <button type="button"
                                                    class="btn btn-sm btn-danger"
                                                    onclick="deleteItem(@item.Id)"
                                                    title="حذف">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="12" class="text-center text-muted py-4">
                                    <i class="fas fa-file-alt fa-2x d-block mb-2"></i>
                                    لا توجد امتحانات لعرضها
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<form id="deleteForm" asp-action="Delete" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" id="deleteId" name="id" value="" />
</form>

@section Scripts {
    <script>
        function deleteItem(id) {
            if (confirm('هل أنت متأكد من حذف هذا الامتحان؟')) {
                document.getElementById('deleteId').value = id;
                document.getElementById('deleteForm').submit();
            }
        }

        $(document).ready(function () {
            $('#examsTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.4/i18n/ar.json'
                },
                order: [[0, 'asc']],
                pageLength: 25
            });
        });
    </script>
}