@model IEnumerable<SchoolERP.Application.DTOs.TeacherSubjects.TeacherSubjectDto>

@{
    ViewData["Title"] = "ربط المعلم بالمادة";
    ViewData["PageTitle"] = "إدارة ربط المعلم بالمادة";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h4 class="mb-0"><i class="fas fa-link me-2"></i>@ViewData["PageTitle"]</h4>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>إضافة رابط جديد
    </a>
</div>

<!-- ============================================================ -->
<!-- رسائل التنبيه -->
<!-- ============================================================ -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ============================================================ -->
<!-- جدول الروابط -->
<!-- ============================================================ -->
<div class="table-responsive">
    <table class="table table-striped table-hover table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th style="width: 50px;">#</th>
                <th style="min-width: 140px;">اسم المعلم</th>
                <th style="min-width: 140px;">المادة</th>
                <th style="min-width: 120px;">الصف الدراسي</th>
                <th style="min-width: 100px;">أساسي</th>
                <th style="min-width: 100px;">الحالة</th>
                <th style="min-width: 220px;">الإجراءات</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                int index = 1;
                foreach (var item in Model)
                {
                    <tr>
                        <td class="text-center">@index</td>
                        <td><strong>@item.TeacherName</strong><br /><small class="text-muted">@item.TeacherCode</small></td>
                        <td>@item.SubjectName</td>
                        <td>@item.GradeLevelName</td>
                        <td>
                            @if (item.IsPrimary)
                            {
                                <span class="badge bg-success"><i class="fas fa-star me-1"></i>أساسي</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">غير أساسي</span>
                            }
                        </td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>مفعل</span>
                            }
                            else
                            {
                                <span class="badge bg-danger"><i class="fas fa-times-circle me-1"></i>غير مفعل</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm flex-wrap gap-1" role="group">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm" title="تفاصيل">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm" title="تعديل">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;">
                                    <button type="submit" class="btn btn-danger btn-sm" title="حذف" onclick="return confirm('هل أنت متأكد من حذف هذا الرابط؟')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    index++;
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">
                        <i class="fas fa-link fa-2x d-block mb-2"></i>
                        لا يوجد روابط
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>