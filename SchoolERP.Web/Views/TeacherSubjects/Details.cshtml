@model SchoolERP.Application.DTOs.TeacherSubjects.TeacherSubjectDto

@{
    ViewData["Title"] = "تفاصيل الرابط";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <!-- عنوان الصفحة -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <i class="fas fa-link text-info"></i>
            تفاصيل ربط المعلم بالمادة
        </h1>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="fas fa-edit"></i> تعديل
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-right"></i> العودة للقائمة
            </a>
        </div>
    </div>

    <!-- بطاقة التفاصيل -->
    <div class="card shadow-sm">
        <div class="card-header bg-info text-white">
            <i class="fas fa-info-circle"></i>
            معلومات الرابط
        </div>
        <div class="card-body">
            <div class="row">
                <!-- المعلم -->
                <div class="col-md-6 mb-3">
                    <div class="card border-primary h-100">
                        <div class="card-header bg-primary text-white">
                            <i class="fas fa-user-tie"></i> بيانات المعلم
                        </div>
                        <div class="card-body">
                            <dl class="row mb-0">
                                <dt class="col-sm-4">الاسم:</dt>
                                <dd class="col-sm-8">
                                    <strong>@Model.TeacherName</strong>
                                </dd>
                                <dt class="col-sm-4">الكود:</dt>
                                <dd class="col-sm-8">
                                    <span class="badge bg-info">@Model.TeacherCode</span>
                                </dd>
                            </dl>
                        </div>
                    </div>
                </div>

                <!-- المادة -->
                <div class="col-md-6 mb-3">
                    <div class="card border-success h-100">
                        <div class="card-header bg-success text-white">
                            <i class="fas fa-book"></i> بيانات المادة
                        </div>
                        <div class="card-body">
                            <dl class="row mb-0">
                                <dt class="col-sm-4">اسم المادة:</dt>
                                <dd class="col-sm-8">
                                    <strong>@Model.SubjectName</strong>
                                </dd>
                                <dt class="col-sm-4">كود المادة:</dt>
                                <dd class="col-sm-8">
                                    <span class="badge bg-secondary">@Model.SubjectCode</span>
                                </dd>
                                <dt class="col-sm-4">الصف الدراسي:</dt>
                                <dd class="col-sm-8">
                                    <span class="badge bg-dark">@Model.GradeLevelName</span>
                                </dd>
                            </dl>
                        </div>
                    </div>
                </div>

                <!-- تفاصيل إضافية -->
                <div class="col-md-12">
                    <div class="card border-secondary">
                        <div class="card-header bg-secondary text-white">
                            <i class="fas fa-cogs"></i> تفاصيل إضافية
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="text-center">
                                        <h6 class="text-muted">المادة الأساسية</h6>
                                        @if (Model.IsPrimary)
                                        {
                                            <span class="badge bg-success fs-5 p-2">
                                                <i class="fas fa-check-circle"></i> نعم
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary fs-5 p-2">لا</span>
                                        }
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="text-center">
                                        <h6 class="text-muted">الحصص الأسبوعية</h6>
                                        <span class="badge bg-warning text-dark fs-5 p-2">
                                            <i class="fas fa-clock"></i> @Model.WeeklyHours حصة
                                        </span>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="text-center">
                                        <h6 class="text-muted">الحالة</h6>
                                        @if (Model.IsActive)
                                        {
                                            <span class="badge bg-success fs-5 p-2">
                                                <i class="fas fa-check"></i> مفعل
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger fs-5 p-2">
                                                <i class="fas fa-times"></i> غير مفعل
                                            </span>
                                        }
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="text-center">
                                        <h6 class="text-muted">تاريخ الإنشاء</h6>
                                        <span class="badge bg-info text-white fs-6 p-2">
                                            @Model.CreatedAt.ToString("yyyy/MM/dd - hh:mm tt")
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>