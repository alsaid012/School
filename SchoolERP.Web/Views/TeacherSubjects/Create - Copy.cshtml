@model SchoolERP.Application.DTOs.TeacherSubjects.CreateTeacherSubjectDto

@{
    ViewData["Title"] = "إنشاء رابط جديد";
    ViewData["PageTitle"] = "إنشاء رابط جديد";
}

<div class="card shadow-sm">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0"><i class="fas fa-link me-2"></i>إنشاء رابط جديد بين المعلم والمادة</h5>
    </div>
    <div class="card-body">
        <form method="post" asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="TeacherId" class="form-label">
                            <i class="fas fa-chalkboard-teacher me-1"></i>المعلم <span class="text-danger">*</span>
                        </label>
                        <select asp-for="TeacherId" class="form-select">
                            <option value="">اختر المعلم...</option>
                            @if (ViewBag.Teachers != null)
                            {
                                foreach (var teacher in ViewBag.Teachers)
                                {
                                    @* <option value="@teacher.Id">@teacher.FullName</option> *@
                                    var fullName = teacher.User?.FullName ?? teacher.TeacherCode;
                                    <option value="@teacher.Id">@fullName</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="TeacherId" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="SubjectId" class="form-label">
                            <i class="fas fa-book me-1"></i>المادة <span class="text-danger">*</span>
                        </label>
                        <select asp-for="SubjectId" class="form-select">
                            <option value="">اختر المادة...</option>
                            @if (ViewBag.Subjects != null)
                            {
                                foreach (var subject in ViewBag.Subjects)
                                {
                                    <option value="@subject.Id">@subject.SubjectName</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="SubjectId" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="IsPrimary" />
                            <label class="form-check-label" asp-for="IsPrimary">
                                <i class="fas fa-star me-1"></i>مادة أساسية للمعلم
                            </label>
                        </div>
                        <span asp-validation-for="IsPrimary" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <hr />
            <button type="submit" class="btn btn-success">
                <i class="fas fa-save me-2"></i>حفظ
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-times me-2"></i>إلغاء
            </a>
        </form>
    </div>
</div>