@model IEnumerable<SchoolERP.Application.DTOs.TeacherSubjects.TeacherSubjectDto>

@{
    ViewData["Title"] = "إدارة ربط المعلمين بالمواد";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <!-- عنوان الصفحة -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <i class="fas fa-link text-primary"></i>
            ربط المعلمين بالمواد الدراسية
        </h1>
        <a asp-action="Create" class="btn btn-primary btn-lg">
            <i class="fas fa-plus-circle"></i>
            إضافة رابط جديد
        </a>
    </div>

    <!-- بطاقة المعلومات -->
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <i class="fas fa-list"></i>
            قائمة الروابط
            <span class="badge bg-light text-primary float-end">
                @Model.Count() رابط
            </span>
        </div>
        <div class="card-body">
            <!-- جدول البيانات -->
            <div class="table-responsive">
                <table class="table table-hover table-striped" id="teacherSubjectsTable">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>
                                <i class="fas fa-user-tie"></i>
                                @Html.DisplayNameFor(m => m.TeacherName)
                            </th>
                            <th>
                                <i class="fas fa-code"></i>
                                @Html.DisplayNameFor(m => m.TeacherCode)
                            </th>
                            <th>
                                <i class="fas fa-book"></i>
                                @Html.DisplayNameFor(m => m.SubjectName)
                            </th>
                            <th>
                                <i class="fas fa-graduation-cap"></i>
                                @Html.DisplayNameFor(m => m.GradeLevelName)
                            </th>
                            <th>
                                <i class="fas fa-star"></i>
                                @Html.DisplayNameFor(m => m.IsPrimary)
                            </th>
                            <th>
                                <i class="fas fa-clock"></i>
                                @Html.DisplayNameFor(m => m.WeeklyHours)
                            </th>
                            <th>
                                <i class="fas fa-toggle-on"></i>
                                @Html.DisplayNameFor(m => m.IsActive)
                            </th>
                            <th class="text-center">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            int index = 1;
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@index</td>
                                    <td>
                                        <strong>@item.TeacherName</strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@item.TeacherCode</span>
                                    </td>
                                    <td>@item.SubjectName</td>
                                    <td>
                                        <span class="badge bg-secondary">@item.GradeLevelName</span>
                                    </td>
                                    <td>
                                        @if (item.IsPrimary)
                                        {
                                            <span class="badge bg-success">
                                                <i class="fas fa-check-circle"></i> أساسية
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">ثانوية</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-warning text-dark">
                                            @item.WeeklyHours حصة
                                        </span>
                                    </td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                <i class="fas fa-check"></i> مفعل
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                <i class="fas fa-times"></i> غير مفعل
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-info" title="تفاصيل">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-warning" title="تعديل">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <button type="button"
                                                    class="btn btn-sm btn-danger"
                                                    onclick="deleteItem(@item.Id, '@item.TeacherName')"
                                                    title="حذف">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted py-4">
                                    <i class="fas fa-inbox fa-2x d-block mb-2"></i>
                                    لا توجد روابط لعرضها
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- نموذج حذف مخفي -->
<form id="deleteForm" asp-action="Delete" method="post" style="display:none;">
    <input type="hidden" id="deleteId" name="id" value="" />
</form>

<!-- السكربتات -->
@section Scripts {
    <script>
        // ✅ دالة الحذف
        function deleteItem(id, teacherName) {
            if (confirm(`هل أنت متأكد من حذف رابط المعلم "${teacherName}"؟`)) {
                document.getElementById('deleteId').value = id;
                document.getElementById('deleteForm').submit();
            }
        }

        // ✅ تفعيل DataTable إذا كنت تستخدمه
        $(document).ready(function () {
            $('#teacherSubjectsTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.4/i18n/ar.json'
                },
                order: [[0, 'asc']],
                pageLength: 10
            });
        });
    </script>
}

