@model SchoolERP.Application.DTOs.Common.PagedResultDto<SchoolERP.Application.DTOs.Subjects.SubjectDto>

@{
    ViewData["Title"] = "المواد الدراسية";
    ViewData["PageTitle"] = "إدارة المواد الدراسية";
}

<!-- ============================================================ -->
<!-- عنوان الصفحة + زر الإضافة -->
<!-- ============================================================ -->
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h4 class="mb-0"><i class="fas fa-book me-2"></i>@ViewData["PageTitle"]</h4>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>إضافة مادة جديدة
    </a>
</div>

<!-- ============================================================ -->
<!-- رسائل التنبيه -->
<!-- ============================================================ -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ============================================================ -->
<!-- شريط البحث -->
<!-- ============================================================ -->
<div class="card mb-3 shadow-sm">
    <div class="card-body">
        <form method="get" asp-action="Index">
            <div class="row g-3">
                <div class="col-md-8">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" name="searchTerm" class="form-control" placeholder="بحث باسم المادة أو الكود..." value="@ViewBag.SearchTerm" />
                    </div>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search me-1"></i>بحث
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- ============================================================ -->
<!-- جدول المواد الدراسية -->
<!-- ============================================================ -->
<div class="table-responsive">
    <table class="table table-striped table-hover table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th style="width: 50px;">#</th>
                <th style="min-width: 150px;">اسم المادة</th>
                <th style="min-width: 100px;">الكود</th>
                <th style="min-width: 120px;">الصف</th>
                <th style="min-width: 120px;">المدرسة</th>
                <th style="min-width: 100px;">عدد المعلمين</th>
                <th style="min-width: 100px;">الحالة</th>
                <th style="min-width: 220px;">الإجراءات</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Items != null && Model.Items.Any())
            {
                int index = (Model.PageNumber - 1) * Model.PageSize + 1;
                foreach (var subject in Model.Items)
                {
                    <tr>
                        <td class="text-center">@index</td>
                        <td><strong>@subject.SubjectName</strong></td>
                        <td><span class="badge bg-secondary">@subject.SubjectCode</span></td>
                        <td>@subject.GradeLevelName</td>
                        <td>@subject.SchoolName</td>
                        <td>@subject.TeachersCount</td>
                        <td>
                            @if (subject.IsActive)
                            {
                                <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>مفعل</span>
                            }
                            else
                            {
                                <span class="badge bg-danger"><i class="fas fa-times-circle me-1"></i>غير مفعل</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm flex-wrap gap-1" role="group">
                                <!-- تفاصيل -->
                                <a asp-action="Details" asp-route-id="@subject.Id" class="btn btn-info btn-sm" title="تفاصيل">
                                    <i class="fas fa-eye"></i>
                                </a>

                                <!-- تعديل -->
                                <a asp-action="Edit" asp-route-id="@subject.Id" class="btn btn-warning btn-sm" title="تعديل">
                                    <i class="fas fa-edit"></i>
                                </a>

                                <!-- ✅ تفعيل / إلغاء التفعيل -->
                                @if (subject.IsActive)
                                {
                                    <form asp-action="ToggleActive" asp-route-id="@subject.Id" method="post" style="display:inline;">
                                        <button type="submit" class="btn btn-secondary btn-sm" title="إلغاء التفعيل" onclick="return confirm('هل أنت متأكد من إلغاء تفعيل هذه المادة؟')">
                                            <i class="fas fa-pause"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="ToggleActive" asp-route-id="@subject.Id" method="post" style="display:inline;">
                                        <button type="submit" class="btn btn-success btn-sm" title="تفعيل" onclick="return confirm('هل أنت متأكد من تفعيل هذه المادة؟')">
                                            <i class="fas fa-play"></i>
                                        </button>
                                    </form>
                                }

                                <!-- حذف -->
                                <form asp-action="Delete" asp-route-id="@subject.Id" method="post" style="display:inline;">
                                    <button type="submit" class="btn btn-danger btn-sm" title="حذف" onclick="return confirm('هل أنت متأكد من حذف هذه المادة؟')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    index++;
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">
                        <i class="fas fa-book fa-2x d-block mb-2"></i>
                        لا يوجد مواد دراسية
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- ============================================================ -->
<!-- Pagination -->
<!-- ============================================================ -->
@if (Model != null && Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination justify-content-center">
            @if (Model.HasPreviousPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-pageSize="@Model.PageSize" asp-route-searchTerm="@ViewBag.SearchTerm">
                        <i class="fas fa-chevron-right"></i> السابق
                    </a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link"><i class="fas fa-chevron-right"></i> السابق</span>
                </li>
            }

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                if (i == Model.PageNumber)
                {
                    <li class="page-item active"><span class="page-link">@i</span></li>
                }
                else if (i <= 3 || i >= Model.TotalPages - 2 || Math.Abs(i - Model.PageNumber) <= 1)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-pageSize="@Model.PageSize" asp-route-searchTerm="@ViewBag.SearchTerm">@i</a>
                    </li>
                }
                else if (i == 4 || i == Model.TotalPages - 3)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
            }

            @if (Model.HasNextPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-pageSize="@Model.PageSize" asp-route-searchTerm="@ViewBag.SearchTerm">
                        التالي <i class="fas fa-chevron-left"></i>
                    </a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">التالي <i class="fas fa-chevron-left"></i></span>
                </li>
            }
        </ul>
    </nav>
}

<!-- ============================================================ -->
<!-- إحصائيات سريعة -->
<!-- ============================================================ -->
<div class="row g-3 mt-2">
    <div class="col-md-4">
        <div class="card bg-light shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-muted mb-1"><i class="fas fa-book me-1"></i>إجمالي المواد</h6>
                <h3 class="mb-0">@Model.TotalCount</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-light shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-muted mb-1"><i class="fas fa-layer-group me-1"></i>الصفحة الحالية</h6>
                <h3 class="mb-0">@Model.PageNumber من @Model.TotalPages</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-light shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-muted mb-1"><i class="fas fa-list me-1"></i>عدد العناصر</h6>
                <h3 class="mb-0">@Model.Items.Count</h3>
            </div>
        </div>
    </div>
</div>