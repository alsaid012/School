@model SchoolERP.Application.DTOs.ClassSchedules.ClassScheduleDto

@{
    ViewData["Title"] = "تفاصيل الحصة";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <!-- عنوان الصفحة -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <i class="fas fa-info-circle text-info"></i>
            تفاصيل الحصة
        </h1>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="fas fa-edit"></i> تعديل
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-right"></i> العودة
            </a>
        </div>
    </div>

    <!-- بطاقة التفاصيل -->
    <div class="card shadow-sm">
        <div class="card-header bg-info text-white">
            <i class="fas fa-calendar-day"></i>
            معلومات الحصة
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">
                            <i class="fas fa-calendar text-primary"></i> السنة الدراسية
                        </dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-info">@Model.AcademicYearName</span>
                        </dd>

                        <dt class="col-sm-4">
                            <i class="fas fa-graduation-cap text-secondary"></i> الصف
                        </dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-secondary">@Model.GradeLevelName</span>
                        </dd>

                        <dt class="col-sm-4">
                            <i class="fas fa-chalkboard text-primary"></i> الفصل
                        </dt>
                        <dd class="col-sm-8">
                            <strong>@Model.ClassRoomName</strong>
                        </dd>

                        <dt class="col-sm-4">
                            <i class="fas fa-book text-warning"></i> المادة
                        </dt>
                        <dd class="col-sm-8">@Model.SubjectName</dd>

                        <dt class="col-sm-4">
                            <i class="fas fa-user-tie text-success"></i> المعلم
                        </dt>
                        <dd class="col-sm-8">@Model.TeacherName</dd>
                    </dl>
                </div>

                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">
                            <i class="fas fa-calendar-day text-primary"></i> اليوم
                        </dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-primary">@Model.DayName</span>
                        </dd>

                        <dt class="col-sm-4">
                            <i class="fas fa-clock text-success"></i> الوقت
                        </dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-success">
                                @Model.StartTime.ToString("hh\\:mm") - @Model.EndTime.ToString("hh\\:mm")
                            </span>
                        </dd>

                        <dt class="col-sm-4">
                            <i class="fas fa-sort-numeric-up text-info"></i> رقم الحصة
                        </dt>
                        <dd class="col-sm-8">
                            @if (Model.PeriodNumber.HasValue)
                            {
                                <span class="badge bg-warning text-dark">@Model.PeriodNumber</span>
                            }
                            else
                            {
                                <span class="text-muted">غير محدد</span>
                            }
                        </dd>

                        <dt class="col-sm-4">
                            <i class="fas fa-toggle-on text-success"></i> الحالة
                        </dt>
                        <dd class="col-sm-8">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">
                                    <i class="fas fa-check"></i> مفعل
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    <i class="fas fa-times"></i> غير مفعل
                                </span>
                            }
                        </dd>

                        <!-- ❌ تم إزالة DurationMinutes -->
                        <dt class="col-sm-4">
                            <i class="fas fa-clock text-muted"></i> المدة
                        </dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-secondary">
                                @((Model.EndTime - Model.StartTime).TotalMinutes) دقيقة
                            </span>
                        </dd>
                    </dl>
                </div>

                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="col-md-12 mt-3">
                        <hr />
                        <strong><i class="fas fa-sticky-note text-muted"></i> ملاحظات:</strong>
                        <p class="mt-2 p-3 bg-light rounded">@Model.Notes</p>
                    </div>
                }

                <div class="col-md-12 mt-3">
                    <hr />
                    <div class="text-muted small">
                        <i class="fas fa-calendar-plus"></i> تاريخ الإنشاء: @Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")
                        @if (Model.UpdatedAt.HasValue)
                        {
                            <span class="ms-3">
                                <i class="fas fa-calendar-edit"></i> آخر تحديث: @Model.UpdatedAt.Value.ToString("yyyy/MM/dd HH:mm")
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>