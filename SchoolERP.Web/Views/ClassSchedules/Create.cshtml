@using SchoolERP.Web.ViewModels.ClassSchedule
@model ClassScheduleCreateViewModel

@{
    ViewData["Title"] = "إضافة حصة جديدة";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <!-- عنوان الصفحة -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <i class="fas fa-plus-circle text-success"></i>
            إضافة حصة جديدة
        </h1>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-right"></i> العودة للقائمة
        </a>
    </div>

    <!-- نموذج الإضافة -->
    <div class="card shadow-sm">
        <div class="card-header bg-success text-white">
            <i class="fas fa-plus"></i>
            بيانات الحصة الجديدة
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row">
                    <!-- السنة الدراسية -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="ClassSchedule.AcademicYearId" class="form-label fw-bold">
                            <i class="fas fa-calendar text-primary"></i>
                            السنة الدراسية
                        </label>
                        <!-- ✅ استخدام asp-items مع SelectList -->
                        <select asp-for="ClassSchedule.AcademicYearId"
                                class="form-select form-select-lg"
                                asp-items="@(new SelectList(Model.AcademicYears, "Value", "Text"))">
                            <option value="">-- اختر السنة الدراسية --</option>
                        </select>
                        <span asp-validation-for="ClassSchedule.AcademicYearId" class="text-danger"></span>
                    </div>

                    <!-- الفصل الدراسي -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="ClassSchedule.ClassRoomId" class="form-label fw-bold">
                            <i class="fas fa-chalkboard text-info"></i>
                            الفصل الدراسي
                        </label>
                        <select asp-for="ClassSchedule.ClassRoomId"
                                class="form-select form-select-lg"
                                asp-items="@(new SelectList(Model.ClassRooms, "Value", "Text"))">
                            <option value="">-- اختر الفصل --</option>
                        </select>
                        <span asp-validation-for="ClassSchedule.ClassRoomId" class="text-danger"></span>
                    </div>

                    <!-- المادة -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="ClassSchedule.SubjectId" class="form-label fw-bold">
                            <i class="fas fa-book text-warning"></i>
                            المادة
                        </label>
                        <select asp-for="ClassSchedule.SubjectId"
                                class="form-select form-select-lg"
                                asp-items="@(new SelectList(Model.Subjects, "Value", "Text"))">
                            <option value="">-- اختر المادة --</option>
                        </select>
                        <span asp-validation-for="ClassSchedule.SubjectId" class="text-danger"></span>
                    </div>

                    <!-- المعلم -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="ClassSchedule.TeacherId" class="form-label fw-bold">
                            <i class="fas fa-user-tie text-success"></i>
                            المعلم
                        </label>
                        <select asp-for="ClassSchedule.TeacherId"
                                class="form-select form-select-lg"
                                asp-items="@(new SelectList(Model.Teachers, "Value", "Text"))">
                            <option value="">-- اختر المعلم --</option>
                        </select>
                        <span asp-validation-for="ClassSchedule.TeacherId" class="text-danger"></span>
                    </div>

                    <!-- اليوم -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="ClassSchedule.DayOfWeek" class="form-label fw-bold">
                            <i class="fas fa-calendar-day text-primary"></i>
                            اليوم
                        </label>
                        <select asp-for="ClassSchedule.DayOfWeek"
                                class="form-select form-select-lg"
                                asp-items="@(new SelectList(Model.DaysOfWeek, "Value", "Text"))">
                            <option value="">-- اختر اليوم --</option>
                        </select>
                        <span asp-validation-for="ClassSchedule.DayOfWeek" class="text-danger"></span>
                    </div>

                    <!-- وقت البداية -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="ClassSchedule.StartTime" class="form-label fw-bold">
                            <i class="fas fa-play text-success"></i>
                            وقت البداية
                        </label>
                        <input asp-for="ClassSchedule.StartTime"
                               type="time"
                               class="form-control form-control-lg" />
                        <span asp-validation-for="ClassSchedule.StartTime" class="text-danger"></span>
                    </div>

                    <!-- وقت النهاية -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="ClassSchedule.EndTime" class="form-label fw-bold">
                            <i class="fas fa-stop text-danger"></i>
                            وقت النهاية
                        </label>
                        <input asp-for="ClassSchedule.EndTime"
                               type="time"
                               class="form-control form-control-lg" />
                        <span asp-validation-for="ClassSchedule.EndTime" class="text-danger"></span>
                    </div>

                    <!-- رقم الحصة -->
                    <div class="col-md-12 mb-3">
                        <label asp-for="ClassSchedule.PeriodNumber" class="form-label fw-bold">
                            <i class="fas fa-sort-numeric-up text-info"></i>
                            رقم الحصة (اختياري)
                        </label>
                        <input asp-for="ClassSchedule.PeriodNumber"
                               type="number"
                               min="1"
                               max="10"
                               class="form-control form-control-lg"
                               placeholder="مثال: 1" />
                        <span asp-validation-for="ClassSchedule.PeriodNumber" class="text-danger"></span>
                        <small class="text-muted">رقم الحصة من 1 إلى 10 (اختياري)</small>
                    </div>
                </div>

                <!-- أزرار التحكم -->
                <div class="mt-4 d-flex gap-2 border-top pt-3">
                    <button type="submit" class="btn btn-success btn-lg">
                        <i class="fas fa-save"></i> حفظ الحصة
                    </button>
                    <a asp-action="Index" class="btn btn-secondary btn-lg">
                        <i class="fas fa-times"></i> إلغاء
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            // ✅ التحقق من التعارض عند تغيير الوقت
            var conflictChecked = false;

            $('#ClassSchedule_ClassRoomId, #ClassSchedule_AcademicYearId, #ClassSchedule_DayOfWeek, #ClassSchedule_StartTime, #ClassSchedule_EndTime')
                .on('change', function () {
                    conflictChecked = false;
                });

            // ✅ التحقق من الوقت قبل الحفظ
            $('form').on('submit', function (e) {
                var startTime = $('#ClassSchedule_StartTime').val();
                var endTime = $('#ClassSchedule_EndTime').val();

                if (startTime && endTime) {
                    if (startTime >= endTime) {
                        alert('⚠️ وقت النهاية يجب أن يكون بعد وقت البداية');
                        e.preventDefault();
                        return false;
                    }
                }
            });
        });
    </script>
}