@model SchoolERP.Application.DTOs.Auth.ForgotPasswordDto

@{
    ViewData["Title"] = "نسيت كلمة المرور";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - نظام إدارة المدارس</title>
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Cairo', sans-serif;
            min-height: 100vh;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
        .login-card {
            border-radius: 16px;
            border: none;
            box-shadow: 0 20px 60px rgba(0,0,0,0.2);
            overflow: hidden;
        }
        .login-header {
            background: #1a1a2e;
            padding: 30px 25px 20px;
        }
        .login-header h4 {
            color: #fff;
            font-weight: 700;
        }
        .login-header .subtitle {
            color: rgba(255,255,255,0.6);
            font-size: 14px;
        }
        .login-body {
            padding: 30px 25px;
            background: #fff;
        }
        .login-body .form-control {
            border-radius: 10px;
            padding: 12px 15px;
            border: 2px solid #e9ecef;
        }
        .login-body .form-control:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.15);
        }
        .login-body .btn-login {
            background: #1a1a2e;
            border: none;
            border-radius: 10px;
            padding: 12px;
            font-weight: 700;
            font-size: 16px;
            color: #fff;
            transition: all 0.3s;
        }
        .login-body .btn-login:hover {
            background: #0f3460;
            transform: translateY(-2px);
        }
        .login-body .back-link {
            color: #6c757d;
            text-decoration: none;
        }
        .login-body .back-link:hover {
            color: #667eea;
            text-decoration: underline;
        }
        .logo-icon {
            width: 60px;
            height: 60px;
            background: #f0c040;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            color: #1a1a2e;
            margin: 0 auto 12px;
        }
        .field-validation-error {
            color: #e74c3c;
            font-size: 13px;
            margin-top: 5px;
            display: block;
        }
        @@ media (max-width: 576px) {
            .login-body {
                padding: 20px;
            }
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="row justify-content-center align-items-center" style="min-height: 100vh;">
            <div class="col-md-5 col-lg-4">
                
                <div class="login-card">
                    
                    <div class="login-header text-center">
                        <div class="logo-icon">
                            <i class="fas fa-key"></i>
                        </div>
                        <h4>نسيت كلمة المرور</h4>
                        <div class="subtitle">أدخل بريدك الإلكتروني لإعادة تعيين كلمة المرور</div>
                    </div>
                    
                    <div class="login-body">
                        
                        @if (ViewBag.Message != null)
                        {
                            <div class="alert alert-info alert-dismissible fade show" role="alert">
                                <i class="fas fa-info-circle me-2"></i>
                                @ViewBag.Message
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        }

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <form method="post" asp-controller="Auth" asp-action="ForgotPassword">
                            @Html.AntiForgeryToken()
                            
                            <div class="mb-3">
                                <label asp-for="Email" class="form-label fw-semibold">
                                    <i class="fas fa-envelope me-1 text-secondary"></i>
                                    البريد الإلكتروني
                                </label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="example@email.com" autofocus />
                                <span asp-validation-for="Email" class="field-validation-error"></span>
                            </div>

                            <button type="submit" class="btn-login w-100">
                                <i class="fas fa-paper-plane me-2"></i>
                                إرسال رابط إعادة التعيين
                            </button>

                            <div class="text-center mt-3">
                                <a asp-controller="Auth" asp-action="Login" class="back-link">
                                    <i class="fas fa-arrow-right me-1"></i>
                                    العودة إلى تسجيل الدخول
                                </a>
                            </div>
                        </form>
                        
                    </div>
                </div>
                
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>